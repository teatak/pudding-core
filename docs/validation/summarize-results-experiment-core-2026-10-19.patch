+	if !r.Complete || r.FinishReason != "tool_calls" || len(r.Calls) != 2 || r.Calls[0].Arguments != `{"path":"a"}` || r.Calls[1].ID != "call-2" || strings.Contains(string(encoded), "private thought") {
+		t.Fatalf("invalid visible trace: %s", encoded)
+	}
+}
+
+func TestLongBenchmarkCountsNaturalAbsenceAndReadbackAgainstRealEngine(t *testing.T) {
+	original := http.DefaultTransport
+	defer func() { http.DefaultTransport = original }()
+	f := makeLongFixture(0)
+	for _, variant := range []struct{ enabled, emit bool }{{false, false}, {true, false}, {true, true}} {
+		enabled, emit := variant.enabled, variant.emit
+		requests := 0
+		var previous, stage2 tool.ResultReference
+		http.DefaultTransport = probeTransport(func(req *http.Request) (*http.Response, error) {
+			requests++
+			var wire struct {
+				Messages []struct {
+					Role    string          `json:"role"`
+					Content json.RawMessage `json:"content"`
+				} `json:"messages"`
+			}
+			if err := json.NewDecoder(req.Body).Decode(&wire); err != nil {
+				t.Fatal(err)
+			}
+			for _, m := range wire.Messages {
+				if m.Role == "tool" {
+					var text string
+					_ = json.Unmarshal(m.Content, &text)
+					var e struct {
+						Ref tool.ResultReference `json:"result_ref"`
+					}
+					_ = json.Unmarshal([]byte(text), &e)
+					if e.Ref.CallID != "" {
+						previous = e.Ref
+						if requests == 3 {
+							stage2 = e.Ref
+						}
+					}
+				}
+			}
+			var delta map[string]any
+			finish := "stop"
+			if requests <= 8 || (emit && requests == 10) {
+				name := tool.FileSlice
+				args := map[string]any{}
+				if requests <= 8 {
+					args = map[string]any{"scope": "project", "path": f.Expected.Records[requests-1].EvidenceFile, "start": 1, "end": 150}
+					if emit && requests > 1 {
+						args["summarize_results"] = map[string]any{"result_refs": []tool.ResultReference{previous}, "summary": "Retained prior incident facts; continue with next evidence."}
+					}
+				} else {
+					name = tool.HistoryGetMessage
+					args = map[string]any{"result_ref": stage2, "field": "content", "offset": 0, "limit": 8000}
+				}
+				body, _ := json.Marshal(args)
+				delta = map[string]any{"reasoning_content": "fixture", "tool_calls": []any{map[string]any{"index": 0, "id": fmt.Sprintf("call-%d", requests), "type": "function", "function": map[string]any{"name": name, "arguments": string(body)}}}}
+				finish = "tool_calls"
+			} else {
+				answer := f.Marker
+				if requests == 9 {
+					data, _ := json.Marshal(f.Expected)
+					answer = string(data)
+				}
+				delta = map[string]any{"content": answer}
+			}
+			frame, _ := json.Marshal(map[string]any{"model": "deepseek-flash", "choices": []any{map[string]any{"delta": delta, "finish_reason": finish}}})
+			usage := `{"model":"deepseek-flash","choices":[],"usage":{"prompt_tokens":500,"completion_tokens":12,"prompt_tokens_details":{"cached_tokens":100},"completion_tokens_details":{"reasoning_tokens":2}}}`
+			stream := "data: " + string(frame) + "\n\ndata: " + usage + "\n\ndata: [DONE]\n\n"
+			return &http.Response{StatusCode: 200, Header: http.Header{"Content-Type": {"text/event-stream"}}, Body: io.NopCloser(strings.NewReader(stream))}, nil
+		})
+		out, err := longExperiment(context.Background(), &store.ProviderProfile{ID: "deepseek", BaseURL: "https://api.deepseek.com"}, "deepseek-flash", 0, enabled, 12)
+		if err != nil || !out.Main.Correct || !out.Followup.Correct || !out.MeteringOK || out.Main.Requests != 9 || out.Main.BusinessCalls != 8 {
+			t.Fatalf("benchmark: %+v %v", out, err)
