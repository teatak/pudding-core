+type memoConfig struct {
+	enabled bool
+	profile *store.ProviderProfile
+}
+
+func (c *memoConfig) Settings(context.Context) (map[string]string, error) {
+	v := "false"
+	if c.enabled {
+		v = "true"
+	}
+	return map[string]string{"experimental_tool_result_memo": v}, nil
+}
+func (c *memoConfig) GetProviderProfile(context.Context, string) (*store.ProviderProfile, error) {
+	return c.profile, nil
+}
+func (c *memoConfig) ListProviderProfiles(context.Context) ([]*store.ProviderProfile, error) {
+	return []*store.ProviderProfile{c.profile}, nil
+}
+
+type memoTransport func(*http.Request) (*http.Response, error)
+
+func (f memoTransport) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+type memoTools struct {
+	*tool.BuiltinRunner
+	t     *testing.T
+	calls int
+}
+
+func (r *memoTools) Definitions(ctx context.Context, mode string) ([]provider.ToolDef, error) {
+	defs, err := r.BuiltinRunner.Definitions(ctx, mode)
+	var out []provider.ToolDef
+	for _, d := range defs {
+		if d.Name == tool.FileSlice || d.Name == tool.HistoryGetMessage {
+			out = append(out, d)
+		}
+	}
+	return out, err
+}
+func (r *memoTools) Call(_ context.Context, c tool.Call) tool.Result {
+	r.calls++
+	if strings.Contains(string(c.Args), `"summarize_results"`) {
+		r.t.Error("memo reached execution")
+	}
+	body := "implementation is 401"
+	if r.calls == 1 {
+		body = strings.Repeat("ORIGINAL-INVENTORY-EVIDENCE ", 400)
+	}
+	return tool.Result{CallID: c.CallID, Name: c.Name, Ok: true, Content: body}
+}
+func memoJSON(v any) string { b, _ := json.Marshal(v); return string(b) }
+func memoSSE(id, args string) string {
+	return "data: " + memoJSON(map[string]any{"choices": []any{map[string]any{"delta": map[string]any{"reasoning_content": "native " + id, "tool_calls": []any{map[string]any{"index": 0, "id": id, "type": "function", "function": map[string]any{"name": tool.FileSlice, "arguments": args}}}}, "finish_reason": "tool_calls"}}}) + "\n\ndata: [DONE]\n\n"
+}
