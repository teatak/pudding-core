@@ -0,0 +1,164 @@
+package sqlitestore
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"path/filepath"
+	"testing"
+
+	"github.com/teatak/pudding-core/internal/event"
+	"github.com/teatak/pudding-core/internal/store"
+)
+
+func TestToolMemoCommitRollsBackOutputOnStaleRevision(t *testing.T) {
+	ctx := context.Background()
+	db, err := Open(filepath.Join(t.TempDir(), "test.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	if err := db.CreateSession(ctx, &store.Session{ID: "s", Provider: "test", Model: "m"}); err != nil {
+		t.Fatal(err)
+	}
+	_, err = db.BeginTurn(ctx, store.BeginTurnInput{SessionID: "s", TurnID: "t", UserMessageID: "u", ClientMessageID: "c", UserText: "task"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	c := store.ToolMemoContext{SessionID: "s", Epoch: "epoch", ChainID: "chain", Revision: 1}
+	if err := db.SaveToolMemoContext(ctx, store.ToolMemoCommit{Context: c}); err != nil {
+		t.Fatal(err)
+	}
+	c.Revision = 2
+	if _, err := db.AppendTurnOutput(ctx, store.AppendTurnOutputInput{TurnID: "t", Parts: []store.ContentPart{
+		{Type: store.ContentPartToolUse, CallID: "a", Name: "read", Args: json.RawMessage(`{}`)},
+		{Type: store.ContentPartToolResult, CallID: "a", Name: "read", Content: "evidence"},
+	}}); err != nil {
+		t.Fatal(err)
+	}
+	var published []event.Event
+	db.SetEventPublisher(func(ev event.Event) { published = append(published, ev) })
+	c.Decisions = []store.ToolMemoDecision{{ID: "d", TurnID: "t", RequestID: "batch", BatchCalls: []string{"a"}, Note: "facts", Applied: []store.ToolMemoRef{{TurnID: "t", CallID: "a"}}}}
+	in := store.AppendTurnOutputInput{TurnID: "t", Parts: store.TextPart("committed output"), ToolMemo: &store.ToolMemoCommit{ExpectedRevision: 1, Context: c}}
+	if _, err := db.AppendTurnOutput(ctx, in); err != nil {
+		t.Fatal(err)
+	}
+	if len(published) != 1 || published[0].Kind != event.TurnMemo || published[0].MemoID != "d" || published[0].MessageID == "" {
+		t.Fatalf("memo event: %+v", published)
+	}
+	in.Parts = store.TextPart("MUST ROLL BACK")
+	if _, err := db.AppendTurnOutput(ctx, in); !errors.Is(err, store.ErrHistoryChanged) {
+		t.Fatal("stale batch accepted", err)
+	}
+	messages, _ := db.ListMessages(ctx, "s", 0)
+	for _, m := range messages {
+		if m.Text == "MUST ROLL BACK" {
+			t.Fatal("non-atomic output")
+		}
+	}
+	if len(published) != 1 {
+		t.Fatal("rollback published a note")
+	}
+	turn, err := db.GetConversationTurn(ctx, "s", "t")
+	if err != nil {
+		t.Fatal(err)
+	}
+	notes := 0
+	for _, m := range turn.Messages {
+		for _, note := range store.ToolMemoNotes(m.Metadata) {
+			notes++
+			if note.ID != "d" || note.BatchID != "batch" || note.Note != "facts" || m.ID != published[0].MessageID || m.Role != store.RoleTool {
+				t.Fatalf("misplaced note: %+v %+v", m, note)
+			}
+		}
+	}
+	if notes != 1 {
+		t.Fatalf("notes=%d", notes)
+	}
+	events, err := db.EventsAfter(ctx, "s", published[0].Seq-1, 0)
+	if err != nil || len(events) != 1 || events[0].MemoID != "d" {
+		t.Fatal("memo replay lost", err)
+	}
+	// Losing the canonical anchor must roll back both the private projection and
+	// a preceding public note/event in the same transaction.
+	bad := c
+	bad.Revision = 3
+	bad.Decisions = append(append([]store.ToolMemoDecision(nil), c.Decisions...),
+		store.ToolMemoDecision{ID: "second", TurnID: "t", RequestID: "b2", BatchCalls: []string{"a"}, Note: "second note"},
+		store.ToolMemoDecision{ID: "missing", TurnID: "t", RequestID: "b3", BatchCalls: []string{"absent"}, Note: "missing anchor"})
+	if _, err := db.AppendTurnOutput(ctx, store.AppendTurnOutputInput{TurnID: "t", ToolMemo: &store.ToolMemoCommit{ExpectedRevision: 2, Context: bad}}); err == nil {
+		t.Fatal("missing anchor accepted")
+	}
+	if len(published) != 1 {
+		t.Fatal("partial transaction published")
+	}
+	restored, err := db.GetToolMemoContext(ctx, "s")
+	if err != nil || restored.Revision != 2 || len(restored.Decisions) != 1 {
+		t.Fatal("decision changed on replay", err)
+	}
+	turn, err = db.GetConversationTurn(ctx, "s", "t")
+	if err != nil {
+		t.Fatal(err)
+	}
+	notes = 0
+	for _, m := range turn.Messages {
+		notes += len(store.ToolMemoNotes(m.Metadata))
+	}
+	if notes != 1 {
+		t.Fatal("rolled back note leaked into history")
+	}
+}
+
+func TestToolMemoNoteFollowsAttachmentsAndSurvivesResetAndClone(t *testing.T) {
+	ctx := context.Background()
+	db, _ := openTestStore(t)
+	if err := db.CreateSession(ctx, &store.Session{ID: "s", Provider: "mock", Model: "mock"}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := db.BeginTurn(ctx, store.BeginTurnInput{SessionID: "s", TurnID: "t", UserMessageID: "u", ClientMessageID: "c", UserText: "task"}); err != nil {
+		t.Fatal(err)
+	}
+	parts := []store.ContentPart{
+		{Type: store.ContentPartToolUse, CallID: "a", Name: "read", Args: json.RawMessage(`{}`)},
+		{Type: store.ContentPartToolUse, CallID: "b", Name: "read", Args: json.RawMessage(`{}`)},
+		{Type: store.ContentPartToolResult, CallID: "b", Name: "read", Content: "b"},
+		{Type: store.ContentPartToolResult, CallID: "a", Name: "read", Content: "a"},
+		{Type: store.ContentPartAttachment, CallID: "image", Name: "image.png", AttachmentKey: "image", MIME: "image/png", URL: "/attachments/image", Size: 1},
+	}
+	if _, err := db.AppendTurnOutput(ctx, store.AppendTurnOutputInput{TurnID: "t", Parts: parts}); err != nil {
+		t.Fatal(err)
+	}
+	c := store.ToolMemoContext{SessionID: "s", Epoch: "e", ChainID: "c", Revision: 1,
+		Decisions: []store.ToolMemoDecision{{ID: "note", RequestID: "batch", TurnID: "t", BatchCalls: []string{"a", "b"}, Note: "facts"}}}
+	if _, err := db.AppendTurnOutput(ctx, store.AppendTurnOutputInput{TurnID: "t", ToolMemo: &store.ToolMemoCommit{Context: c}}); err != nil {
+		t.Fatal(err)
+	}
+	messages, err := db.ListMessages(ctx, "s", 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	anchor := messages[len(messages)-1]
+	if len(store.ToolMemoNotes(anchor.Metadata)) != 1 || anchor.Parts[0].Type != store.ContentPartAttachment {
+		t.Fatal("note precedes batch attachment")
+	}
+	if _, err := db.CloneSession(ctx, store.CloneSessionInput{SourceSessionID: "s", TargetSessionID: "clone", ThroughMessageID: anchor.ID, TitleSuffix: " copy",
+		AttachmentReplacements: map[string]store.Attachment{"image": {ID: "clone-image", AttachmentKey: "clone-image", Name: "image.png", MIME: "image/png", URL: "/attachments/clone-image", Size: 1}},
+	}); err != nil {
+		t.Fatal(err)
+	}
+	cloned, err := db.ListMessages(ctx, "clone", 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := store.ToolMemoNotes(cloned[len(cloned)-1].Metadata); len(got) != 1 || got[0].ID != "note" {
+		t.Fatal("clone lost note")
+	}
+	c.Epoch, c.ChainID, c.Revision, c.Decisions = "reset", "reset-chain", 2, nil
+	if err := db.SaveToolMemoContext(ctx, store.ToolMemoCommit{ExpectedRevision: 1, Context: c}); err != nil {
+		t.Fatal(err)
+	}
+	messages, err = db.ListMessages(ctx, "s", 0)
+	if err != nil || len(store.ToolMemoNotes(messages[len(messages)-1].Metadata)) != 1 {
+		t.Fatal("epoch reset erased historical note", err)
+	}
+}
diff --git a/internal/store/tool_memo.go b/internal/store/tool_memo.go
new file mode 100644
--- /dev/null
+++ b/internal/store/tool_memo.go
@@ -0,0 +1,103 @@
+package store
+
+import (
+	"context"
+	"encoding/json"
+)
+
+// ToolMemoNote is presentation data attached to the last canonical message of
+// a closed tool batch, in metadata.toolMemos. It never becomes a model part.
+// IDs are scoped to the conversation; cloning preserves their local identity.
+type ToolMemoNote struct {
+	ID      string   `json:"id"`
+	BatchID string   `json:"batchID"`
+	CallIDs []string `json:"callIDs"`
+	Note    string   `json:"note"`
+}
+
+func ToolMemoNotes(metadata json.RawMessage) []ToolMemoNote {
+	var data struct {
+		Notes []ToolMemoNote `json:"toolMemos"`
+	}
+	_ = json.Unmarshal(metadata, &data)
+	return data.Notes
+}
+
+func WithToolMemoNote(metadata json.RawMessage, note ToolMemoNote) (json.RawMessage, error) {
+	fields := map[string]json.RawMessage{}
+	if len(metadata) > 0 {
+		if err := json.Unmarshal(metadata, &fields); err != nil {
+			return nil, err
+		}
+	}
+	if fields == nil {
+		fields = map[string]json.RawMessage{}
+	}
+	notes := ToolMemoNotes(metadata)
+	for _, existing := range notes {
+		if existing.ID == note.ID {
+			return metadata, nil
+		}
+	}
+	data, err := json.Marshal(append(notes, note))
+	if err != nil {
+		return nil, err
+	}
+	fields["toolMemos"] = data
+	return json.Marshal(fields)
+}
+
+// ToolMemoContext is private Core state. Canonical calls/results are never
+// replaced by these projections. A decision is final: there is no pending state.
+type ToolMemoContext struct {
+	SessionID string             `json:"sessionID"`
+	Epoch     string             `json:"epoch"`
+	Summary   string             `json:"summary"`
+	Boundary  string             `json:"boundary"`
+	ChainID   string             `json:"chainID"`
+	Binding   string             `json:"binding"`
+	Schema    string             `json:"schema"`
+	Revision  int64              `json:"revision"`
+	Disabled  bool               `json:"disabled"`
+	Results   []ToolMemoResult   `json:"results,omitempty"`
+	Decisions []ToolMemoDecision `json:"decisions,omitempty"`
+}
+
+type ToolMemoRef struct {
+	TurnID string `json:"turn_id"`
+	CallID string `json:"call_id"`
+}
+
+type ToolMemoResult struct {
+	Ref  ToolMemoRef `json:"ref"`
+	Name string      `json:"name"`
+}
+
+type ToolMemoSkipped struct {
+	Ref    ToolMemoRef `json:"ref"`
+	Reason string      `json:"reason"`
+}
+
+type ToolMemoDecision struct {
+	ID              string            `json:"id"`
+	RequestID       string            `json:"requestID"`
+	TurnID          string            `json:"turnID"`
+	CarrierID       string            `json:"carrierID"`
+	CarrierArgsHash string            `json:"carrierArgsHash"`
+	BatchCalls      []string          `json:"batchCalls"`
+	Note            string            `json:"note,omitempty"`
+	Applied         []ToolMemoRef     `json:"applied,omitempty"`
+	Skipped         []ToolMemoSkipped `json:"skipped,omitempty"`
+}
+
+type ToolMemoCommit struct {
+	ExpectedRevision int64
+	Context          ToolMemoContext
+}
+
+// Optional interface keeps unrelated stores/test doubles unchanged. SQLite
+// provides CAS plus atomic integration with AppendTurnOutput.
+type ToolMemoStore interface {
+	GetToolMemoContext(context.Context, string) (*ToolMemoContext, error)
+	SaveToolMemoContext(context.Context, ToolMemoCommit) error
+}
diff --git a/cmd/memo-prototype/benchmark.go b/cmd/memo-prototype/benchmark.go
new file mode 100644
--- /dev/null
+++ b/cmd/memo-prototype/benchmark.go
@@ -0,0 +1,693 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/teatak/pudding-core/internal/config"
+	"github.com/teatak/pudding-core/internal/engine"
+	"github.com/teatak/pudding-core/internal/event"
+	"github.com/teatak/pudding-core/internal/provider"
+	"github.com/teatak/pudding-core/internal/provider/openai"
+	"github.com/teatak/pudding-core/internal/provider/registry"
+	"github.com/teatak/pudding-core/internal/store"
+	"github.com/teatak/pudding-core/internal/store/sqlitestore"
+	"github.com/teatak/pudding-core/internal/tool"
+	"github.com/teatak/pudding-core/internal/toolmemo"
+)
+
+const benchmarkVersion = "incident-chain-v1"
+const benchmarkHarnessVersion = "5"
+
+const benchmarkHTTPTimeout = 4 * time.Minute
+const benchmarkPhaseTimeout = 10 * time.Minute
+
+type evidenceRecord struct {
+	Stage        int    `json:"stage"`
+	Service      string `json:"service"`
+	ElapsedMS    int    `json:"elapsed_ms"`
+	Verdict      string `json:"verdict"`
+	EvidenceFile string `json:"evidence_file"`
+}
+type incidentAnswer struct {
+	Records      []evidenceRecord `json:"records"`
+	TotalDelayMS int              `json:"total_delay_ms"`
+	FailedStage  int              `json:"failed_stage"`
+	Repair       string           `json:"repair"`
+}
+type longFixture struct {
+	Files                    map[string]string
+	Prompt, Followup, Marker string
+	Expected                 incidentAnswer
+	gradeMain                func(string) (int, int)
+	gradeFollowup            func(string) (int, int)
+}
+
+// The linked filenames and per-sample values prevent a correct answer without
+// reading the chain. All evidence is synthetic; no user project is uploaded.
+func makeLongFixture(sample int) longFixture {
+	f := longFixture{Files: map[string]string{}}
+	names := make([]string, 8)
+	for i := range names {
+		h := sha256.Sum256([]byte(fmt.Sprintf("%s:%d:%d", benchmarkVersion, sample, i)))
+		names[i] = "evidence_" + hex.EncodeToString(h[:5]) + ".log"
+	}
+	names[0] = "entry.log"
+	trace := fmt.Sprintf("request-%d", 7100+sample*37)
+	f.Marker = fmt.Sprintf("audit-%x", sha256.Sum256([]byte(trace+":stage2")))[:24]
+	f.Expected.FailedStage = 3 + sample%4
+	f.Expected.Repair = fmt.Sprintf("refresh-route-generation-%d", 20+sample*7)
+	services := []string{"edge", "session", "policy", "routing", "quota", "resolver", "storage", "response"}
+	for i, name := range names {
+		r := evidenceRecord{Stage: i + 1, Service: services[i], ElapsedMS: 17 + (sample*31+i*43)%173, Verdict: "ok", EvidenceFile: name}
+		if r.Stage == f.Expected.FailedStage {
+			r.Verdict = "stale_route_generation"
+		}
+		f.Expected.Records = append(f.Expected.Records, r)
+		f.Expected.TotalDelayMS += r.ElapsedMS
+		var b strings.Builder
+		for line := 1; line <= 140; line++ {
+			switch line {
+			case 9:
+				fmt.Fprintf(&b, "trace=%s stage=%d service=%s elapsed_ms=%d\n", trace, r.Stage, r.Service, r.ElapsedMS)
+			case 61:
+				marker := fmt.Sprintf("other-%d-%d", sample, i)
+				if i == 1 {
+					marker = f.Marker
+				}
+				fmt.Fprintf(&b, "trace=%s audit_marker=%s\n", trace, marker)
+			case 101:
+				fmt.Fprintf(&b, "trace=%s verdict=%s\n", trace, r.Verdict)
+				if r.Stage == f.Expected.FailedStage {
+					fmt.Fprintf(&b, "trace=%s remediation=%s\n", trace, f.Expected.Repair)
+				}
+			case 132:
+				next := "END"
+				if i+1 < len(names) {
+					next = names[i+1]
+				}
+				fmt.Fprintf(&b, "trace=%s next_evidence=%s\n", trace, next)
+			default:
+				fmt.Fprintf(&b, "trace=background-%03d service=metrics event=heartbeat latency_ms=%d\n", line, (line*17+i)%90)
+			}
+		}
+		f.Files[name] = b.String()
+	}
+	f.Prompt = fmt.Sprintf(`Investigate incident trace %s, starting at entry.log. Follow the next_evidence links for this trace until END; ignore other traces. Determine each stage's service, elapsed_ms and verdict, the total elapsed time, the failed stage, and its documented remediation. Read evidence before answering; do not guess filenames or values. Return only one JSON object with records (an ordered array of {stage,service,elapsed_ms,verdict,evidence_file}), total_delay_ms, failed_stage, and repair. Evidence filenames must be project-relative.`, trace)
+	f.Prompt += ` The evidence files have up to 141 lines; the links and verdicts can occur beyond the default first page. The available evidence tools are builtin_file_slice and builtin_history_get_message. Numeric fields should be JSON integers.`
+	f.Followup = `Now return only the exact audit_marker recorded for that same trace at stage 2. Use the original conversation evidence; if needed retrieve the original tool-result snapshot, not the current file, which may have changed.`
+	return f
+}
+
+type benchmarkRequest struct {
+	Phase             string             `json:"phase"`
+	Status            int                `json:"status"`
+	DurationMS        int64              `json:"durationMS"`
+	Model             string             `json:"responseModel,omitempty"`
+	Complete          bool               `json:"complete"`
+	UsageSeen         bool               `json:"usageSeen"`
+	Usage             provider.UsageInfo `json:"usage"`
+	ReleasedResults   int                `json:"releasedResults"`
+	ReferencedResults int                `json:"referencedResults"`
+	MemoTools         int                `json:"memoTools"`
+	InstructionsSeen  bool               `json:"instructionsSeen"`
+	SystemSHA256      string             `json:"systemSHA256,omitempty"`
+	FinishReason      string             `json:"finishReason,omitempty"`
+	Calls             []benchmarkCall    `json:"calls,omitempty"`
+	ResultViews       []benchmarkView    `json:"resultViews,omitempty"`
+}
+
+// Only visible tool arguments and result metadata are recorded, never provider
+// reasoning text, request headers, credentials, or entire result bodies.
+type benchmarkCall struct {
+	ID        string `json:"id"`
+	Name      string `json:"name"`
+	Arguments string `json:"arguments"`
+}
+type benchmarkView struct {
+	Ref              tool.ResultReference `json:"ref"`
+	View             string               `json:"view"`
+	ContentBytes     int                  `json:"contentBytes"`
+	SummaryCandidate bool                 `json:"summaryCandidate,omitempty"`
+}
+type benchmarkPhase struct {
+	Requests      int                `json:"requests"`
+	BusinessCalls int                `json:"businessCalls"`
+	ReadbackCalls int                `json:"readbackCalls"`
+	Usage         provider.UsageInfo `json:"usage"`
+	PeakUSD       float64            `json:"estimatedUSDAtPeakRates"`
+	Correct       bool               `json:"correct"`
+	ChecksPassed  int                `json:"checksPassed"`
+	ChecksTotal   int                `json:"checksTotal"`
+	Answer        string             `json:"answer"`
+}
+type benchmarkRun struct {
+	Sample        int                `json:"sample"`
+	Memo          bool               `json:"memo"`
+	StartedAt     time.Time          `json:"startedAt"`
+	Main          benchmarkPhase     `json:"main"`
+	Followup      benchmarkPhase     `json:"followup"`
+	Requests      []benchmarkRequest `json:"requests"`
+	MemoAttempts  int                `json:"memoAttempts"`
+	InvalidMemos  int                `json:"invalidMemos"`
+	AcceptedNotes int                `json:"acceptedNotes"`
+	Applied       int                `json:"applied"`
+	Skipped       map[string]int     `json:"skipped"`
+	MeteringOK    bool               `json:"meteringOK"`
+	Error         string             `json:"error,omitempty"`
+}
+type benchmarkReport struct {
+	Version             string         `json:"fixtureVersion"`
+	HarnessVersion      string         `json:"harnessVersion"`
+	MemoSchemaVersion   string         `json:"memoSchemaVersion"`
+	MemoInstructions    string         `json:"memoInstructions"`
+	SelectedArm         string         `json:"selectedArm"`
+	SampleStart         int            `json:"sampleStart"`
+	MaxMainRequests     int            `json:"maxMainRequests"`
+	MaxFollowupRequests int            `json:"maxFollowupRequests"`
+	TaskPrompts         []string       `json:"taskPrompts"`
+	FollowupPrompt      string         `json:"followupPrompt"`
+	Model               string         `json:"requestedModel"`
+	GeneratedAt         time.Time      `json:"generatedAt"`
+	PricingSource       string         `json:"pricingSource"`
+	PricingDate         string         `json:"pricingDate"`
+	RateExplanation     string         `json:"rateExplanation"`
+	PlannedPairs        int            `json:"plannedPairs,omitempty"`
+	PlannedRuns         int            `json:"plannedRuns"`
+	Runs                []benchmarkRun `json:"runs"`
+}
+
+// Uniform published peak rates make order/time comparisons explicit. This is
+// a usage-based estimate, not an account invoice; off-peak is exactly half.
+func benchmarkCost(u provider.UsageInfo) float64 {
+	return (float64(u.InputUncachedTokens)*0.3 + float64(u.InputCachedTokens)*0.006 + float64(u.OutputContentTokens+u.OutputReasoningTokens)*1.2) / 1e6
+}
+
+func runLongBenchmark(ctx context.Context, profile *store.ProviderProfile, model string, samples, maxRequests int, output string, sampleStart int, arm string) error {
+	if model != "deepseek-flash" || strings.TrimRight(profile.BaseURL, "/") != "https://api.deepseek.com" {
+		return errors.New("long benchmark is restricted to the verified official DeepSeek Flash configuration")
+	}
+	report := benchmarkReport{Version: benchmarkVersion, Model: model, GeneratedAt: time.Now().UTC(), PlannedRuns: samples,
+		MemoSchemaVersion: toolmemo.SchemaVersion, MemoInstructions: toolmemo.Instructions, SelectedArm: arm, SampleStart: sampleStart,
+		HarnessVersion: benchmarkHarnessVersion, MaxMainRequests: maxRequests, MaxFollowupRequests: 4,
+		PricingSource: "https://api-docs.deepseek.com/quick_start/pricing/", PricingDate: "2026-10-19",
+		RateExplanation: "USD/1M tokens at uniform peak rates: uncached input 0.30, cached input 0.006, output including reasoning 1.20. Off-peak half. Not a billing statement; cache conditions are observed, not controlled."}
+	if arm == "paired" {
+		report.PlannedPairs, report.PlannedRuns = samples, samples*2
+	}
+	failed := false
+	for sample := sampleStart; sample < sampleStart+samples; sample++ {
+		f := makeLongFixture(sample)
+		report.TaskPrompts = append(report.TaskPrompts, f.Prompt)
+		report.FollowupPrompt = f.Followup
+		order := []bool{false, true}
+		if sample%2 == 1 {
+			order = []bool{true, false}
+		}
+		if arm != "paired" {
+			order = []bool{arm == "memo"}
+		}
+		for _, enabled := range order {
+			fmt.Fprintf(os.Stderr, "benchmark sample=%d memo=%t started\n", sample, enabled)
+			item, err := longExperiment(ctx, profile, model, sample, enabled, maxRequests)
+			if err != nil {
+				item.Error = err.Error()
+			}
+			failed = failed || err != nil || !item.Main.Correct || !item.Followup.Correct
+			report.Runs = append(report.Runs, item)
+			// Checkpoint every completed run, including failures; never silently
+			// retry a poor answer or discard it from the denominator.
+			data, err := json.MarshalIndent(report, "", "  ")
+			if err != nil {
+				return err
+			}
+			if err = os.WriteFile(output, append(data, '\n'), 0600); err != nil {
+				return err
+			}
+			fmt.Fprintf(os.Stderr, "benchmark sample=%d memo=%t main=%t followup=%t applied=%d requests=%d/%d USD=%.6f/%.6f error=%t\n", sample, enabled, item.Main.Correct, item.Followup.Correct, item.Applied, item.Main.Requests, item.Followup.Requests, item.Main.PeakUSD, item.Followup.PeakUSD, item.Error != "")
+		}
+	}
+	if failed {
+		return errors.New("one or more benchmark runs failed; all completed outcomes retained in report")
+	}
+	return nil
+}
+
+type benchmarkTools struct {
+	*engineTools
+	mu               sync.Mutex
+	calls, readbacks int
+	allowedFiles     map[string]string
+}
+
+func (r *benchmarkTools) Call(ctx context.Context, c tool.Call) tool.Result {
+	r.mu.Lock()
+	r.calls++
+	if c.Name == tool.HistoryGetMessage {
+		r.readbacks++
+	}
+	r.mu.Unlock()
+	if r.allowedFiles != nil && c.Name == tool.FileSlice {
+		var a struct {
+			Scope string `json:"scope"`
+			Path  string `json:"path"`
+		}
+		if json.Unmarshal(c.Args, &a) != nil || a.Scope != "project" {
+			return tool.Result{CallID: c.CallID, Name: c.Name, Content: `{"ok":false,"error":"fixture_scope","detail":"Read only the listed project snapshot files with scope=project."}`}
+		}
+		name := filepath.Clean(a.Path)
+		if filepath.IsAbs(name) && len(c.ProjectDirs) == 1 {
+			name, _ = filepath.Rel(c.ProjectDirs[0], name)
+		}
+		if _, ok := r.allowedFiles[name]; !ok {
+			return tool.Result{CallID: c.CallID, Name: c.Name, Content: `{"ok":false,"error":"fixture_file_unavailable","detail":"Only files listed in the task are available."}`}
+		}
+	}
+	return callPrototypeTool(ctx, r.BuiltinRunner, c)
+}
+func (r *benchmarkTools) counts() (int, int) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return r.calls, r.readbacks
+}
+
+type benchmarkBody struct {
+	io.ReadCloser
+	pending []byte
+	request *benchmarkRequest
+	started time.Time
+}
+
+func (b *benchmarkBody) Read(p []byte) (int, error) {
+	n, err := b.ReadCloser.Read(p)
+	b.pending = append(b.pending, p[:n]...)
+	for {
+		line, rest, ok := bytes.Cut(b.pending, []byte{'\n'})
+		if !ok {
+			break
+		}
+		b.pending = rest
+		if !bytes.HasPrefix(line, []byte("data:")) {
+			continue
+		}
+		data := bytes.TrimSpace(line[5:])
+		if bytes.Equal(data, []byte("[DONE]")) {
+			b.request.Complete = true
+			continue
+		}
+		var frame struct {
+			Model   string `json:"model"`
+			Choices []struct {
+				Index        int    `json:"index"`
+				FinishReason string `json:"finish_reason"`
+				Delta        struct {
+					Calls []struct {
+						Index    int    `json:"index"`
+						ID       string `json:"id"`
+						Function struct {
+							Name      string `json:"name"`
+							Arguments string `json:"arguments"`
+						} `json:"function"`
+					} `json:"tool_calls"`
+				} `json:"delta"`
+			} `json:"choices"`
+			Usage *struct {
+				Prompt        int `json:"prompt_tokens"`
+				Completion    int `json:"completion_tokens"`
+				PromptDetails struct {
+					Cached int `json:"cached_tokens"`
+				} `json:"prompt_tokens_details"`
+				CompletionDetails struct {
+					Reasoning int `json:"reasoning_tokens"`
+				} `json:"completion_tokens_details"`
+			} `json:"usage"`
+		}
+		if json.Unmarshal(data, &frame) != nil {
+			continue
+		}
+		if frame.Model != "" {
+			b.request.Model = frame.Model
+		}
+		for _, choice := range frame.Choices {
+			if choice.Index != 0 {
+				continue
+			}
+			if choice.FinishReason != "" {
+				b.request.FinishReason = choice.FinishReason
+			}
+			for _, delta := range choice.Delta.Calls {
+				if delta.Index < 0 || delta.Index >= 128 {
+					continue
+				}
+				for len(b.request.Calls) <= delta.Index {
+					b.request.Calls = append(b.request.Calls, benchmarkCall{})
+				}
+				call := &b.request.Calls[delta.Index]
+				call.ID += delta.ID
+				call.Name += delta.Function.Name
+				call.Arguments += delta.Function.Arguments
+			}
+		}
+		if u := frame.Usage; u != nil {
+			b.request.UsageSeen = true
+			b.request.Usage = provider.UsageInfo{InputUncachedTokens: u.Prompt - u.PromptDetails.Cached, InputCachedTokens: u.PromptDetails.Cached, OutputContentTokens: u.Completion - u.CompletionDetails.Reasoning, OutputReasoningTokens: u.CompletionDetails.Reasoning}
+		}
+	}
+	if len(b.pending) > 1<<20 {
+		b.pending = nil
+	}
+	b.request.DurationMS = time.Since(b.started).Milliseconds()
+	return n, err
+}
+
+func longExperiment(ctx context.Context, profile *store.ProviderProfile, model string, sample int, enabled bool, maxRequests int) (benchmarkRun, error) {
+	return evidenceExperiment(ctx, profile, model, sample, enabled, maxRequests, makeLongFixture(sample))
+}
+
+func evidenceExperiment(ctx context.Context, profile *store.ProviderProfile, model string, sample int, enabled bool, maxRequests int, f longFixture) (out benchmarkRun, runErr error) {
+	out = benchmarkRun{Sample: sample, Memo: enabled, StartedAt: time.Now().UTC(), Skipped: map[string]int{}}
+	root, err := os.MkdirTemp("", "pudding-memo-long-*")
+	if err != nil {
+		return out, err
+	}
+	defer os.RemoveAll(root)
+	for name, body := range f.Files {
+		if !filepath.IsLocal(name) {
+			return out, errors.New("fixture path is not local")
+		}
+		if err = os.MkdirAll(filepath.Dir(filepath.Join(root, name)), 0700); err != nil {
+			return out, err
+		}
+		if err = os.WriteFile(filepath.Join(root, name), []byte(body), 0600); err != nil {
+			return out, err
+		}
+	}
+	db, err := sqlitestore.Open(filepath.Join(root, "core.db"))
+	if err != nil {
+		return out, err
+	}
+	defer db.Close()
+	copyProfile := *profile
+	copyProfile.Protocol = "openai-compatible"
+	copyProfile.Models = []store.ProviderModel{{ID: model, Capabilities: &store.ModelCaps{Tools: true}, Limits: &store.ModelLimits{MaxOutputTokens: 4096, MaxToolLoops: maxRequests}, ProviderOptions: &store.ProviderOptions{OpenAI: map[string]any{"reasoning_effort": "high"}}}}
+	if err = db.CreateProject(ctx, &store.Project{ID: "project", RootDirs: []string{root}, ApprovalMode: store.ApprovalFull}); err != nil {
+		return out, err
+	}
+	if err = db.CreateSession(ctx, &store.Session{ID: "session", Title: "Incident investigation benchmark", Provider: copyProfile.ProfileID(), Model: model, ProjectID: "project", ActiveMode: store.ModeCode, ModeLease: store.ModeLeaseSession}); err != nil {
+		return out, err
+	}
+	phase := "main"
+	var requests []*benchmarkRequest
+	transport := probeTransport(func(req *http.Request) (*http.Response, error) {
+		used := 0
+		for _, r := range requests {
+			if r.Phase == phase {
+				used++
+			}
+		}
+		limit := maxRequests
+		if phase == "followup" {
+			limit = 4
+		}
+		if used >= limit {
+			return nil, errors.New("benchmark phase request limit")
+		}
+		r := &benchmarkRequest{Phase: phase}
+		requests = append(requests, r)
+		data, err := io.ReadAll(req.Body)
+		if err != nil {
+			return nil, err
+		}
+		_ = req.Body.Close()
+		req.Body = io.NopCloser(bytes.NewReader(data))
+		var wire struct {
+			Messages []struct {
+				Role    string
+				Content json.RawMessage
+			} `json:"messages"`
+			Tools []struct {
+				Function struct {
+					Parameters struct {
+						Properties map[string]json.RawMessage `json:"properties"`
+					} `json:"parameters"`
+				} `json:"function"`
+			} `json:"tools"`
+		}
+		if json.Unmarshal(data, &wire) == nil {
+			for _, t := range wire.Tools {
+				if t.Function.Parameters.Properties[toolmemo.ParameterName] != nil {
+					r.MemoTools++
+				}
+			}
+			for _, m := range wire.Messages {
+				if m.Role == "system" {
+					var content string
+					if json.Unmarshal(m.Content, &content) == nil {
+						r.InstructionsSeen = strings.Contains(content, toolmemo.Instructions)
+						r.SystemSHA256 = toolmemo.Hash(content)
+					}
+				}
+				if m.Role == "tool" {
+					var content string
+					if json.Unmarshal(m.Content, &content) != nil {
+						continue
+					}
+					var e struct {
+						View             string               `json:"view"`
+						Ref              tool.ResultReference `json:"result_ref"`
+						Content          string               `json:"content"`
+						SummaryCandidate bool                 `json:"summary_candidate"`
+					}
+					if json.Unmarshal([]byte(content), &e) == nil {
+						if e.Ref.CallID != "" {
+							r.ReferencedResults++
+							r.ResultViews = append(r.ResultViews, benchmarkView{Ref: e.Ref, View: e.View, ContentBytes: len(e.Content), SummaryCandidate: e.SummaryCandidate})
+						}
+						if e.View == "released" {
+							r.ReleasedResults++
+						}
+					}
+				}
+			}
+		}
+		started := time.Now()
+		response, err := http.DefaultTransport.RoundTrip(req)
+		if err != nil {
+			return nil, err
+		}
+		r.Status = response.StatusCode
+		response.Body = &benchmarkBody{ReadCloser: response.Body, request: r, started: started}
+		return response, nil
+	})
+	client := openai.New(openai.Config{BaseURL: copyProfile.BaseURL, APIKey: config.EffectiveAPIKey(&copyProfile), HTTPClient: &http.Client{Transport: transport, Timeout: benchmarkHTTPTimeout}})
+	runner := &benchmarkTools{engineTools: &engineTools{BuiltinRunner: tool.NewBuiltinRunner(tool.WithHistorySearch(db))}, allowedFiles: f.Files}
+	defer runner.Close()
+	eng := engine.New(db, event.NewHub(), registry.Static(client), engineConfig{&copyProfile, enabled}, engine.WithTools(runner))
+	// Collect even failed runs, and cross-check wire usage against the Engine's
+	// persisted counters. No successful request or readback is omitted from cost.
+	defer func() {
+		_ = eng.Cancel("session")
+		eng.Stop()
+		eng.Wait()
+		for _, r := range requests {
+			out.Requests = append(out.Requests, *r)
+			p := &out.Main
+			if r.Phase == "followup" {
+				p = &out.Followup
+			}
+			p.Requests++
+			addBenchmarkUsage(&p.Usage, r.Usage)
+		}
+		out.Main.PeakUSD = benchmarkCost(out.Main.Usage)
+		out.Followup.PeakUSD = benchmarkCost(out.Followup.Usage)
+		u, err := db.SessionUsage(ctx, "session")
+		out.MeteringOK = err == nil && len(requests) > 0
+		total := out.Main.Usage
+		addBenchmarkUsage(&total, out.Followup.Usage)
+		if err == nil {
+			out.MeteringOK = out.MeteringOK && u.RequestCount == len(requests) && u.CumulativeInputUncachedTokens == total.InputUncachedTokens && u.CumulativeInputCachedTokens == total.InputCachedTokens && u.CumulativeOutputContentTokens == total.OutputContentTokens && u.CumulativeOutputReasoningTokens == total.OutputReasoningTokens
+		}
+		for _, r := range requests {
+			out.MeteringOK = out.MeteringOK && r.Status == 200 && r.Complete && r.UsageSeen
+		}
+		if c, err := db.GetToolMemoContext(ctx, "session"); err == nil {
+			for _, d := range c.Decisions {
+				if d.Note != "" {
+					out.AcceptedNotes++
+				}
+				out.Applied += len(d.Applied)
+				for _, s := range d.Skipped {
+					out.Skipped[s.Reason]++
+				}
+			}
+		}
+		history, _ := db.ListMessages(ctx, "session", 0)
+		for _, m := range history {
+			for _, p := range m.Parts {
+				if p.Type != store.ContentPartToolUse {
+					continue
+				}
+				var args map[string]json.RawMessage
+				if json.Unmarshal(p.Args, &args) == nil && args[toolmemo.ParameterName] != nil {
+					out.MemoAttempts++
+					if _, memo := toolmemo.Extract(p.Args, true); memo == nil {
+						out.InvalidMemos++
+					}
+				}
+			}
+		}
+		if !out.MeteringOK && runErr == nil {
+			runErr = errors.New("wire and persisted usage did not reconcile")
+		}
+	}()
+	answer, status, err := benchmarkSubmit(ctx, eng, db, "main", f.Prompt)
+	out.Main.Answer = answer
+	out.Main.BusinessCalls, out.Main.ReadbackCalls = runner.counts()
+	if f.gradeMain != nil {
+		out.Main.ChecksPassed, out.Main.ChecksTotal = f.gradeMain(answer)
+	} else {
+		out.Main.ChecksPassed, out.Main.ChecksTotal = gradeIncident(answer, f.Expected)
+	}
+	out.Main.Correct = err == nil && status == store.TurnCompleted && out.Main.ChecksPassed == out.Main.ChecksTotal
+	if err != nil {
+		return out, err
+	}
+	if status != store.TurnCompleted {
+		return out, fmt.Errorf("main turn status: %s", status)
+	}
+	// A later question asks for a detail not required in the main answer. Change
+	// the source to distinguish real snapshot recovery from a fresh file read.
+	for name := range f.Files {
+		if err = os.WriteFile(filepath.Join(root, name), []byte("CURRENT FILE CHANGED; no original audit marker\n"), 0600); err != nil {
+			return out, err
+		}
+	}
+	phase = "followup"
+	answer, status, err = benchmarkSubmit(ctx, eng, db, "followup", f.Followup)
+	out.Followup.Answer = answer
+	calls, reads := runner.counts()
+	out.Followup.BusinessCalls = calls - out.Main.BusinessCalls
+	out.Followup.ReadbackCalls = reads - out.Main.ReadbackCalls
+	out.Followup.ChecksTotal = 1
+	if strings.Trim(strings.TrimSpace(answer), "`\"'") == f.Marker {
+		out.Followup.ChecksPassed = 1
+	}
+	if f.gradeFollowup != nil {
+		out.Followup.ChecksPassed, out.Followup.ChecksTotal = f.gradeFollowup(answer)
+	}
+	out.Followup.Correct = err == nil && status == store.TurnCompleted && out.Followup.ChecksPassed == out.Followup.ChecksTotal
+	if err != nil {
+		return out, err
+	}
+	if status != store.TurnCompleted {
+		return out, fmt.Errorf("followup turn status: %s", status)
+	}
+	return out, nil
+}
+
+func addBenchmarkUsage(a *provider.UsageInfo, b provider.UsageInfo) {
+	a.InputUncachedTokens += b.InputUncachedTokens
+	a.InputCachedTokens += b.InputCachedTokens
+	a.CacheCreationTokens += b.CacheCreationTokens
+	a.OutputContentTokens += b.OutputContentTokens
+	a.OutputReasoningTokens += b.OutputReasoningTokens
+}
+func benchmarkSubmit(ctx context.Context, eng *engine.Engine, db *sqlitestore.Store, id, prompt string) (string, store.TurnStatus, error) {
+	timeout, cancel := context.WithTimeout(ctx, benchmarkPhaseTimeout)
+	defer cancel()
+	submitted, err := eng.Submit(timeout, engine.SubmitInput{SessionID: "session", ClientMessageID: id, Text: prompt})
+	if err != nil {
+		return "", "", err
+	}
+	if err = eng.WaitSession(timeout, "session"); err != nil {
+		_ = eng.Cancel("session")
+		eng.Wait()
+		return "", "", err
+	}
+	turn, err := db.GetConversationTurn(ctx, "session", submitted.TurnID)
+	if err != nil {
+		return "", "", err
+	}
+	// Grade the final text message only; process narration cannot accidentally
+	// supply a fact missing from the actual answer.
+	answer := ""
+	for _, m := range turn.Messages {
+		if m.Role == store.RoleAssistant && m.Kind == store.MessageKindText && strings.TrimSpace(m.Text) != "" {
+			answer = m.Text
+		}
+	}
+	return answer, turn.Status, nil
+}
+func gradeIncident(answer string, want incidentAnswer) (int, int) {
+	const total = 11 // eight complete records, total delay, failed stage, remediation
+	answer = strings.TrimSpace(answer)
+	if strings.HasPrefix(answer, "```") {
+		if i := strings.IndexByte(answer, '\n'); i >= 0 {
+			answer = strings.TrimSuffix(strings.TrimSpace(answer[i+1:]), "```")
+		}
+	}
+	var fields map[string]json.RawMessage
+	if json.Unmarshal([]byte(answer), &fields) != nil {
+		return 0, total
+	}
+	passed := 0
+	var records []map[string]json.RawMessage
+	_ = json.Unmarshal(fields["records"], &records)
+	if len(records) == len(want.Records) {
+		for i, r := range want.Records {
+			for _, key := range []string{"stage", "elapsed_ms"} {
+				if n, ok := benchmarkInteger(records[i][key]); ok {
+					records[i][key] = json.RawMessage(strconv.Itoa(n))
+				}
+			}
+			data, _ := json.Marshal(records[i])
+			var got evidenceRecord
+			if json.Unmarshal(data, &got) == nil && reflect.DeepEqual(got, r) {
+				passed++
+			}
+		}
+	}
+	if n, ok := benchmarkInteger(fields["total_delay_ms"]); ok && n == want.TotalDelayMS {
+		passed++
+	}
+	if n, ok := benchmarkInteger(fields["failed_stage"]); ok && n == want.FailedStage {
+		passed++
+	}
+	var repair string
+	if json.Unmarshal(fields["repair"], &repair) == nil && repair == want.Repair {
+		passed++
+	}
+	return passed, total
+}
+
+// Grade facts independently and tolerate integer strings; this benchmark is
+// about retaining evidence, not enforcing a structured-output protocol.
+func benchmarkInteger(raw json.RawMessage) (int, bool) {
+	var n int
+	if len(raw) == 0 || string(raw) == "null" {
+		return 0, false
+	}
+	if json.Unmarshal(raw, &n) == nil {
+		return n, true
+	}
+	var s string
+	if json.Unmarshal(raw, &s) != nil {
+		return 0, false
+	}
+	n, err := strconv.Atoi(s)
+	return n, err == nil
+}
