+
+	"github.com/teatak/pudding-core/internal/provider"
+)
+
+type preparedTransportFunc func(*http.Request) (*http.Response, error)
+
+func (f preparedTransportFunc) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestPreparedChatFreezesExactlySentProjection(t *testing.T) {
+	req := provider.Request{Model: "m", System: "system", Messages: []provider.Message{{Role: provider.RoleUser, Text: "original"}},
+		Tools: []provider.ToolDef{{Name: "read", InputSchema: json.RawMessage(`{"type":"object","properties":{}}`)}}}
+	p, err := PrepareChatRequest(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Neither mutating the original request nor a returned input view may alter
+	// the model input whose provenance was inspected before the HTTP call.
+	req.Messages[0].Text = "mutated original"
+	req.Tools[0].InputSchema[0] = '!'
+	input := p.Input()
+	input.Messages.(json.RawMessage)[0] = '!'
+	requests := 0
+	c := New(Config{BaseURL: "https://fixture.invalid", HTTPClient: &http.Client{Transport: preparedTransportFunc(func(r *http.Request) (*http.Response, error) {
+		requests++
+		var body chatRequest
+		if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+			t.Fatal(err)
+		}
+		if body.Messages[0].Content != "system" || body.Messages[1].Content != "original" || !json.Valid(body.Tools[0].Function.Parameters) {
+			t.Fatal("prepared body mutated")
+		}
+		messages, _ := json.Marshal(body.Messages[1:])
+		if string(messages) != string(p.Input().Messages.(json.RawMessage)) {
+			t.Fatal("inspected and sent projections differ")
+		}
+		return &http.Response{StatusCode: 200, Body: io.NopCloser(strings.NewReader("data: {\"choices\":[{\"delta\":{\"content\":\"ok\"},\"finish_reason\":\"stop\"}]}\n\ndata: [DONE]\n\n"))}, nil
+	})}})
+	stream, err := c.StreamPrepared(context.Background(), p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for chunk := range stream {
+		if chunk.Err != nil {
+			t.Fatal(chunk.Err)
+		}
+	}
+	if requests != 1 {
+		t.Fatalf("HTTP attempts: %d", requests)
+	}
+}
+
+func TestPreparedChatDoesNotHideUsageOptionRetry(t *testing.T) {
+	requests := 0
+	c := New(Config{BaseURL: "https://fixture.invalid", HTTPClient: &http.Client{Transport: preparedTransportFunc(func(*http.Request) (*http.Response, error) {
+		requests++
+		return &http.Response{StatusCode: 400, Body: io.NopCloser(strings.NewReader("stream_options include_usage unsupported"))}, nil
+	})}})
+	p, err := PrepareChatRequest(provider.Request{Model: "m"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	stream, err := c.StreamPrepared(context.Background(), p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	failed := false
+	for chunk := range stream {
+		failed = failed || chunk.Err != nil
+	}
+	if !failed || requests != 1 {
+		t.Fatalf("failed=%t requests=%d", failed, requests)
+	}
+}
