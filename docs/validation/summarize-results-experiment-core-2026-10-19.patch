+	}
+	// Switching configuration closes admission permanently within the epoch.
+	eng.store = db
+	eng.rebuildBuilder()
+	defs, _ := eng.toolDefinitions(ctx, "s", store.ModeCode)
+	changed := *resolved
+	changed.model = "other"
+	switched, err := eng.memoContext(ctx, "s", &changed, defs)
+	if err != nil || !switched.Disabled || switched.Epoch != epoch || switched.ChainID == chain {
+		t.Fatal("bad switch", err)
+	}
+	back, err := eng.memoContext(ctx, "s", resolved, defs)
+	if err != nil || !back.Disabled || !toolmemo.Applied(back, ref) {
+		t.Fatal("switch back reopened or restored body", err)
+	}
+	req, err = eng.buildProviderRequest(ctx, "s", resolved, store.ModeCode)
+	if err != nil {
+		t.Fatal(err)
+	}
+	frozen, err = eng.prepareMemoRequest(ctx, "s", req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	wire := memoJSON(frozen.HTTP.Input().Messages)
+	if strings.Contains(wire, "native handler") || strings.Contains(wire, "ORIGINAL-INVENTORY-EVIDENCE") || strings.Count(wire, note) != 1 {
+		t.Fatalf("handoff violated fixed projection: %s", wire)
+	}
+	// Reset is the only boundary that may reopen admission and discard old
+	// projections; the checkpoint itself remains canonical history.
+	reset := &store.Message{ID: "reset", Role: store.RoleSummary, Kind: store.MessageKindSummary, Metadata: store.NewSubagentResetMetadata(store.SubagentResetInput{SessionID: "s", ParentSessionID: "parent", ParentTurnID: "parent-turn", CallID: "reset-call", ExpectedTurnID: "t"}).JSON()}
+	eng.store = &memoHistoryStore{Store: db, messages: []*store.Message{reset, {ID: "new-user", Role: store.RoleUser}}}
+	if old, err := eng.loadMemo(ctx, "s"); err != nil || old != nil {
+		t.Fatal("reset exposed previous epoch before next turn", err)
+	}
+	resetContext, err := eng.memoContext(ctx, "s", resolved, defs)
+	if err != nil || resetContext.Disabled || resetContext.Epoch == epoch || len(resetContext.Results) != 0 || len(resetContext.Decisions) != 0 {
+		t.Fatal("reset did not establish fresh boundary", err)
+	}
+
+}
+
+type memoHistoryStore struct {
+	*sqlitestore.Store
+	messages []*store.Message
+}
+
+func (s *memoHistoryStore) ListMessages(context.Context, string, int) ([]*store.Message, error) {
+	return s.messages, nil
+}
+
+func TestMemoCallIDsAreCheckedAgainstOriginatingRequest(t *testing.T) {
+	source := &toolmemo.Prepared{SeenCalls: map[string]bool{"old": true}}
+	call := func(id string) tool.Call { return tool.Call{CallID: id, Args: json.RawMessage(`{}`)} }
+	if err := validateMemoCalls(source, []tool.Call{call("new-a"), call("new-b")}); err != nil {
+		t.Fatal(err)
+	}
+	for _, calls := range [][]tool.Call{{call("old")}, {call("new-a"), call("new-a")}, {{CallID: "partial", Args: json.RawMessage(`{`)}}} {
+		if err := validateMemoCalls(source, calls); err == nil {
+			t.Fatal("accepted reused/incomplete call")
+		}
+	}
+	if len(source.SeenCalls) != 1 {
+		t.Fatal("validation mutated the frozen source snapshot")
+	}
+}
diff --git a/internal/provider/openai/prepared.go b/internal/provider/openai/prepared.go
new file mode 100644
--- /dev/null
+++ b/internal/provider/openai/prepared.go
@@ -0,0 +1,90 @@
+package openai
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+
+	"github.com/teatak/pudding-core/internal/provider"
+)
+
+// PreparedChatRequest freezes the final chat projection, including native
+// continuation replay and tool-pair sanitization. Input returns independent
+// copies for local provenance and budget checks; StreamPrepared sends these
+// exact bytes without rebuilding or retrying the request.
+type PreparedChatRequest struct {
+	body  []byte
+	input provider.WireInput
+}
+
+func PrepareChatRequest(req provider.Request) (*PreparedChatRequest, error) {
+	body := chatRequestBody(req, true)
+	data, err := json.Marshal(body)
+	if err != nil {
+		return nil, err
+	}
+	messages := body.Messages
+	if req.System != "" {
+		messages = messages[1:]
+	}
+	messageData, err := json.Marshal(messages)
+	if err != nil {
+		return nil, err
+	}
+	toolData, err := json.Marshal(body.Tools)
+	if err != nil {
+		return nil, err
+	}
+	return &PreparedChatRequest{body: data, input: provider.WireInput{
+		System: req.System, Messages: json.RawMessage(messageData), Tools: json.RawMessage(toolData),
+	}}, nil
+}
+
+func (p *PreparedChatRequest) Input() provider.WireInput {
+	return provider.WireInput{
+		System:   p.input.System,
+		Messages: append(json.RawMessage(nil), p.input.Messages.(json.RawMessage)...),
+		Tools:    append(json.RawMessage(nil), p.input.Tools.(json.RawMessage)...),
+	}
+}
+
+// StreamPrepared intentionally performs one HTTP attempt. In particular, it
+// does not retry an unsupported stream_options response behind the caller's
+// request counter. The normal Client.Stream compatibility behavior is unchanged.
+func (c *Client) StreamPrepared(ctx context.Context, prepared *PreparedChatRequest) (<-chan provider.Chunk, error) {
+	if prepared == nil || len(prepared.body) == 0 {
+		return nil, errors.New("openai: prepared request is required")
+	}
+	if c.baseURL == "" {
+		return nil, errors.New("openai: base url is required")
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, c.baseURL+"/chat/completions", bytes.NewReader(prepared.body))
+	if err != nil {
+		return nil, err
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Accept", "text/event-stream")
+	provider.SetAppAttribution(req.Header)
+	if c.apiKey != "" {
+		req.Header.Set("Authorization", "Bearer "+c.apiKey)
+	}
+	out := make(chan provider.Chunk)
+	go func() {
+		defer close(out)
+		resp, err := c.http.Do(req)
+		if err == nil {
+			defer resp.Body.Close()
+			if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+				err = &httpStatusError{status: resp.StatusCode, summary: redact(bodySummary(resp.Body), c.apiKey)}
+			} else {
+				err = readSSE(ctx, resp.Body, out)
+			}
+		}
+		if err != nil {
+			emit(ctx, out, provider.Chunk{Err: err})
+		}
+	}()
+	return out, nil
+}
