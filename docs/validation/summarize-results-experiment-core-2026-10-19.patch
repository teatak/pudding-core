+	return provider.ModelConfig{Capabilities: &provider.ModelCapabilities{Tools: true}, Limits: &provider.ModelLimits{MaxOutputTokens: 4096}, ProviderOptions: &provider.ModelProviderOptions{OpenAI: map[string]any{"reasoning_effort": "high"}}}
