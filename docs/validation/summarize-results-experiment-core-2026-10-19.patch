+package main
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"testing"
+)
+
+func TestRepositoryGradeSeparatesFactsAndSourceEvidence(t *testing.T) {
+	task := repositoryTask{Files: map[string]string{"a.go": "package a\nconst limit = 250\n"}, Expected: map[string]json.RawMessage{"limit": json.RawMessage(`250`), "safe": json.RawMessage(`false`)}, EvidenceFiles: map[string][]string{"limit": {"a.go"}, "safe": {"a.go"}}}
+	for _, test := range []struct {
+		answer string
+		passed int
+	}{
+		{`{"answers":{"limit":250,"safe":false},"evidence":{"limit":[{"file":"a.go","start_line":2,"end_line":2,"quote":"const limit = 250"}]}}`, 3},
+		{`{"answers":{"limit":999,"safe":false},"evidence":{"limit":[{"file":"a.go","start_line":2,"end_line":2,"quote":"const limit = 250"}]}}`, 2},
+		{`{"answers":{"limit":250,"safe":false},"evidence":{"limit":[{"file":"a.go","start_line":1,"end_line":1,"quote":"const limit = 250"}]}}`, 2},
+		{`{"answers":{"limit":250,"safe":false},"evidence":{"limit":[{"file":"elsewhere.go","start_line":2,"end_line":2,"quote":"const limit = 250"}]}}`, 2},
+		{`{"answers":{"limit":250},"evidence":{"limit":[{"file":"a.go","start_line":-1,"end_line":20,"quote":"fabricated evidence"}]}}`, 1},
+	} {
+		p, n := gradeRepository(test.answer, task)
+		if p != test.passed || n != 4 {
+			t.Fatalf("grade=%d/%d want=%d/4", p, n, test.passed)
+		}
+	}
+}
+
+func TestRepositorySnapshotRejectsChangedSourceAndTraversal(t *testing.T) {
+	body := "package a\n"
+	sum := sha256.Sum256([]byte(body))
+	task := repositoryTask{ID: "review", Files: map[string]string{"a.go": body}, SHA256: map[string]string{"a.go": hex.EncodeToString(sum[:])}, Expected: map[string]json.RawMessage{"safe": json.RawMessage(`true`)}, EvidenceFiles: map[string][]string{"safe": {"a.go"}}}
+	if err := validateRepositoryTask(task); err != nil {
+		t.Fatal(err)
+	}
+	task.Files["a.go"] += "// changed"
+	if validateRepositoryTask(task) == nil {
+		t.Fatal("changed snapshot accepted")
+	}
+	task.Files = map[string]string{"../a.go": body}
+	task.SHA256 = map[string]string{"../a.go": hex.EncodeToString(sum[:])}
+	if validateRepositoryTask(task) == nil {
+		t.Fatal("project escape accepted")
+	}
+}
