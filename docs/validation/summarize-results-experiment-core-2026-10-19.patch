+func TestLongFixtureAndGrader(t *testing.T) {
+	f := makeLongFixture(2)
+	if len(f.Files) != 8 || strings.Contains(f.Prompt, "summarize_results") || strings.Contains(f.Prompt, f.Marker) {
+		t.Fatal("biased or incomplete fixture")
+	}
+	for i, r := range f.Expected.Records {
+		body := f.Files[r.EvidenceFile]
+		if len(body) > 11000 || !strings.Contains(body, fmt.Sprintf("elapsed_ms=%d", r.ElapsedMS)) {
+			t.Fatal("fixture exceeds preview or lacks evidence")
+		}
+		if i+1 < len(f.Expected.Records) && !strings.Contains(body, f.Expected.Records[i+1].EvidenceFile) {
+			t.Fatal("broken evidence chain")
+		}
+	}
+	data, _ := json.Marshal(f.Expected)
+	if n, total := gradeIncident(string(data), f.Expected); n != total {
+		t.Fatal("correct answer rejected")
+	}
+	quoted := strings.Replace(string(data), `"failed_stage":5`, `"failed_stage":"5"`, 1)
+	if n, total := gradeIncident(quoted, f.Expected); n != total {
+		t.Fatal("integer string lost factual credit")
+	}
+	badField := strings.Replace(string(data), `"failed_stage":5`, `"failed_stage":"unknown"`, 1)
+	if n, total := gradeIncident(badField, f.Expected); n != total-1 {
+		t.Fatal("one malformed field erased unrelated facts")
+	}
+	wrong := f.Expected
+	wrong.TotalDelayMS++
+	data, _ = json.Marshal(wrong)
+	if n, total := gradeIncident(string(data), f.Expected); n != total-1 {
+		t.Fatal("wrong aggregation accepted")
+	}
+	if n, _ := gradeIncident("Narration with values "+string(data), f.Expected); n != 0 {
+		t.Fatal("process text is not a final answer")
+	}
+}
+
+func TestBenchmarkMeterCountsReasoningOnceAndParsesFragmentedSSE(t *testing.T) {
+	data := `data: {"model":"deepseek-flash","usage":{"prompt_tokens":500,"completion_tokens":12,"prompt_tokens_details":{"cached_tokens":100},"completion_tokens_details":{"reasoning_tokens":2}}}` + "\n\ndata: [DONE]\n\n"
+	r := &benchmarkRequest{}
+	b := benchmarkBody{ReadCloser: io.NopCloser(strings.NewReader(data)), request: r}
+	buf := make([]byte, 1)
+	for {
+		if _, err := b.Read(buf); err != nil {
+			break
+		}
+	}
+	want := provider.UsageInfo{InputUncachedTokens: 400, InputCachedTokens: 100, OutputContentTokens: 10, OutputReasoningTokens: 2}
+	if !r.Complete || !r.UsageSeen || r.Usage != want {
+		t.Fatalf("meter: %+v", r)
+	}
+	if got := benchmarkCost(want); got < 0.00013499 || got > 0.00013501 {
+		t.Fatalf("wrong cache/reasoning cost: %f", got)
+	}
+}
+
+func TestBenchmarkTraceReassemblesVisibleCallsWithoutReasoning(t *testing.T) {
+	frames := []string{
+		`{"choices":[{"index":0,"delta":{"reasoning_content":"private thought","tool_calls":[{"index":0,"id":"call-1","function":{"name":"builtin_file_slice","arguments":"{\"path\":"}}]}}]}`,
+		`{"choices":[{"index":0,"delta":{"tool_calls":[{"index":0,"function":{"arguments":"\"a\"}"}},{"index":1,"id":"call-2","function":{"name":"builtin_file_slice","arguments":"{}"}}]},"finish_reason":"tool_calls"}]}`,
+	}
