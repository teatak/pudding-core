+package sqlitestore
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"time"
+
+	"github.com/teatak/pudding-core/internal/event"
+	"github.com/teatak/pudding-core/internal/store"
+)
+
+const toolMemoSchema = `CREATE TABLE IF NOT EXISTS tool_memo_contexts (
+ session_id TEXT PRIMARY KEY REFERENCES sessions(id) ON DELETE CASCADE,
+ revision INTEGER NOT NULL,
+ data TEXT NOT NULL
+);`
+
+// The projection checkpoint, public note, and replayable invalidation commit
+// together. Epoch reset may clear private decisions, but historical notes stay
+// on their messages. No synthetic message changes native continuation indexes.
+func commitToolMemoBatchTx(ctx context.Context, tx *sql.Tx, turn *store.Turn, in store.ToolMemoCommit) error {
+	var raw string
+	var previous store.ToolMemoContext
+	err := tx.QueryRowContext(ctx, `SELECT data FROM tool_memo_contexts WHERE session_id=?`, turn.SessionID).Scan(&raw)
+	if err != nil && !errors.Is(err, sql.ErrNoRows) {
+		return err
+	}
+	if err == nil {
+		if err := json.Unmarshal([]byte(raw), &previous); err != nil {
+			return err
+		}
+	}
+	if err := saveToolMemoTx(ctx, tx, in); err != nil {
+		return err
+	}
+	known := map[string]bool{}
+	for _, d := range previous.Decisions {
+		known[d.ID] = true
+	}
+	for _, d := range in.Context.Decisions {
+		if known[d.ID] {
+			continue
+		}
+		known[d.ID] = true
+		if d.TurnID != turn.ID || d.ID == "" || d.RequestID == "" || len(d.BatchCalls) == 0 {
+			return fmt.Errorf("invalid tool memo batch identity")
+		}
+		if d.Note == "" {
+			continue
+		}
+		messages, err := messagesForTurnTx(ctx, tx, turn.SessionID, turn.ID)
+		if err != nil {
+			return err
+		}
+		calls := map[string]bool{}
+		for _, id := range d.BatchCalls {
+			calls[id] = true
+		}
+		var anchor *store.Message
+		trailingBatch := false
+		for _, m := range messages {
+			matched, attachmentOnly := false, len(m.Parts) > 0
+			for _, p := range m.Parts {
+				if (p.Type == store.ContentPartToolUse || p.Type == store.ContentPartToolResult) && calls[p.CallID] {
+					matched = true
+				}
+				if p.Type != store.ContentPartAttachment {
+					attachmentOnly = false
+				}
+			}
+			// Context attachments are stored after their result as assistant
+			// parts. Keep the note after them too, without crossing a new input.
+			trailingBatch = matched || (trailingBatch && m.Role == store.RoleAssistant && attachmentOnly)
+			if trailingBatch {
+				anchor = m
+			}
+		}
+		if anchor == nil {
+			return fmt.Errorf("tool memo has no canonical batch anchor")
+		}
+		anchor.Metadata, err = store.WithToolMemoNote(anchor.Metadata, store.ToolMemoNote{ID: d.ID, BatchID: d.RequestID, CallIDs: d.BatchCalls, Note: d.Note})
+		if err != nil {
+			return err
+		}
+		if _, err := tx.ExecContext(ctx, `UPDATE messages SET metadata=? WHERE id=?`, string(store.EncodeMessageMetadataForStorage(anchor.Metadata, anchor.ProviderState)), anchor.ID); err != nil {
+			return err
+		}
+		ev := event.Event{Kind: event.TurnMemo, SessionID: turn.SessionID, TurnID: turn.ID, MessageID: anchor.ID, MemoID: d.ID}
+		if err := insertEventTx(ctx, tx, &ev); err != nil {
+			return err
+		}
+	}
+	now := time.Now()
+	if _, err := tx.ExecContext(ctx, `UPDATE turns SET updated_at=? WHERE id=?`, unixMS(now), turn.ID); err != nil {
+		return err
+	}
+	return touchSessionActivityTx(ctx, tx, turn.SessionID, now)
+}
+
+func (s *Store) GetToolMemoContext(ctx context.Context, sessionID string) (*store.ToolMemoContext, error) {
+	var data string
+	if err := s.db.QueryRowContext(ctx, `SELECT data FROM tool_memo_contexts WHERE session_id=?`, sessionID).Scan(&data); err != nil {
+		if errors.Is(err, sql.ErrNoRows) {
+			return nil, store.ErrNotFound
+		}
+		return nil, err
+	}
+	var out store.ToolMemoContext
+	if err := json.Unmarshal([]byte(data), &out); err != nil {
+		return nil, err
+	}
+	return &out, nil
+}
+
+func (s *Store) SaveToolMemoContext(ctx context.Context, in store.ToolMemoCommit) error {
+	return s.tx(ctx, func(ctx context.Context, tx *sql.Tx) error { return saveToolMemoTx(ctx, tx, in) })
+}
+
+func saveToolMemoTx(ctx context.Context, tx *sql.Tx, in store.ToolMemoCommit) error {
+	c := in.Context
+	if c.SessionID == "" || c.Epoch == "" || c.ChainID == "" || c.Revision != in.ExpectedRevision+1 {
+		return fmt.Errorf("invalid tool memo checkpoint")
+	}
+	data, err := json.Marshal(c)
+	if err != nil {
+		return err
+	}
+	var result sql.Result
+	if in.ExpectedRevision == 0 {
+		result, err = tx.ExecContext(ctx, `INSERT INTO tool_memo_contexts(session_id,revision,data) VALUES(?,?,?) ON CONFLICT(session_id) DO NOTHING`, c.SessionID, c.Revision, string(data))
+	} else {
+		result, err = tx.ExecContext(ctx, `UPDATE tool_memo_contexts SET revision=?,data=? WHERE session_id=? AND revision=?`, c.Revision, string(data), c.SessionID, in.ExpectedRevision)
+	}
+	if err != nil {
+		return err
+	}
+	n, err := result.RowsAffected()
+	if err != nil {
+		return err
+	}
+	if n != 1 {
+		return store.ErrHistoryChanged
+	}
+	return nil
+}
diff --git a/internal/store/sqlitestore/tool_memo_test.go b/internal/store/sqlitestore/tool_memo_test.go
