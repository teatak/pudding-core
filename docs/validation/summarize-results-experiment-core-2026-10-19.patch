+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"time"
+
+	"github.com/teatak/pudding-core/internal/config"
+	"github.com/teatak/pudding-core/internal/engine"
+	"github.com/teatak/pudding-core/internal/event"
+	"github.com/teatak/pudding-core/internal/provider"
+	"github.com/teatak/pudding-core/internal/provider/openai"
+	"github.com/teatak/pudding-core/internal/provider/registry"
+	"github.com/teatak/pudding-core/internal/store"
+	"github.com/teatak/pudding-core/internal/store/sqlitestore"
+	"github.com/teatak/pudding-core/internal/tool"
+)
+
+type engineConfig struct {
+	profile *store.ProviderProfile
+	enabled bool
+}
+
+func (c engineConfig) Settings(context.Context) (map[string]string, error) {
+	return map[string]string{"experimental_tool_result_memo": fmt.Sprint(c.enabled)}, nil
+}
+func (c engineConfig) GetProviderProfile(context.Context, string) (*store.ProviderProfile, error) {
+	return c.profile, nil
+}
+func (c engineConfig) ListProviderProfiles(context.Context) ([]*store.ProviderProfile, error) {
+	return []*store.ProviderProfile{c.profile}, nil
+}
+
+type engineTools struct {
+	*tool.BuiltinRunner
+	calls int
+}
+
+func (r *engineTools) Definitions(ctx context.Context, mode string) ([]provider.ToolDef, error) {
+	defs, err := r.BuiltinRunner.Definitions(ctx, mode)
+	var out []provider.ToolDef
+	for _, d := range defs {
+		if d.Name == tool.FileSlice || d.Name == tool.HistoryGetMessage {
+			out = append(out, d)
+		}
+	}
+	return out, err
+}
+func (r *engineTools) Call(ctx context.Context, c tool.Call) tool.Result {
+	r.calls++
+	return callPrototypeTool(ctx, r.BuiltinRunner, c)
+}
+
+func callPrototypeTool(ctx context.Context, runner *tool.BuiltinRunner, c tool.Call) tool.Result {
+	if c.Name != tool.FileSlice && c.Name != tool.HistoryGetMessage {
+		return tool.Result{CallID: c.CallID, Name: c.Name, Content: `{"ok":false,"error":"prototype_tool_unavailable","message":"Use builtin_file_slice or builtin_history_get_message."}`}
+	}
+	return runner.Call(ctx, c)
+}
+
+type engineReport struct {
+	RecoveryUsage     *provider.UsageInfo     `json:"recoveryUsage,omitempty"`
+	TaskRequests      int                     `json:"taskRequests"`
+	RecoveryRequests  int                     `json:"recoveryRequests"`
+	RecoveryPassed    bool                    `json:"recoveryPassed"`
+	RecoveredNoteSent bool                    `json:"recoveredNoteSent"`
+	Engine            bool                    `json:"engine"`
+	Memo              bool                    `json:"memo"`
+	Model             string                  `json:"model"`
+	Requests          int                     `json:"httpRequests"`
+	Tools             int                     `json:"businessCalls"`
+	Applied           int                     `json:"applied"`
+	ReleasedSent      int                     `json:"releasedSent"`
+	NativeChecked     int                     `json:"nativeReplayChecked"`
+	ReasoningSeen     bool                    `json:"reasoningSeen"`
+	RestartOK         bool                    `json:"restartOK"`
+	ReadbackOK        bool                    `json:"snapshotReadbackOK"`
+	PublicNotesOK     bool                    `json:"publicNotesOK"`
+	MemoReplayOK      bool                    `json:"memoReplayOK"`
+	Passed            bool                    `json:"passed"`
+	Usage             *store.SessionUsageStat `json:"usage,omitempty"`
+	Error             string                  `json:"error,omitempty"`
+}
+
+// Real Engine + SQLite, but isolated files, session and profile copy. No daemon
+// settings or user database is changed. The transport records counts only.
+func engineExperiment(ctx context.Context, profile *store.ProviderProfile, model string, enabled bool, maxRequests int, explicit, recovery bool) (engineReport, error) {
+	report := engineReport{Engine: true, Memo: enabled, Model: model}
+	root, err := os.MkdirTemp("", "pudding-memo-engine-*")
+	if err != nil {
+		return report, err
+	}
+	defer os.RemoveAll(root)
+	var inventory strings.Builder
+	inventory.WriteString("Password-reset handler: auth_reset.go\n")
+	for i := 1; i < 160; i++ {
+		fmt.Fprintf(&inventory, "Inventory entry %03d: unrelated_catalog_%03d.go contains lookup and display helpers irrelevant to token expiration.\n", i, i)
+	}
+	if err := os.WriteFile(filepath.Join(root, "inventory.txt"), []byte(inventory.String()), 0600); err != nil {
+		return report, err
+	}
+	if err := os.WriteFile(filepath.Join(root, "auth_reset.go"), []byte("package fixture\nfunc ResetPassword(expiresAt, now int64) int {\n if expiresAt <= now { return 401 }; return 204\n}\n"), 0600); err != nil {
+		return report, err
+	}
+	dbPath := filepath.Join(root, "core.db")
+	db, err := sqlitestore.Open(dbPath)
+	if err != nil {
+		return report, err
+	}
+	defer func() { _ = db.Close() }()
+	copyProfile := *profile
+	copyProfile.Protocol = "openai-compatible"
+	copyProfile.Models = []store.ProviderModel{{ID: model, Capabilities: &store.ModelCaps{Tools: true}, Limits: &store.ModelLimits{MaxOutputTokens: 4096, MaxToolLoops: maxRequests}, ProviderOptions: &store.ProviderOptions{OpenAI: map[string]any{"reasoning_effort": "high"}}}}
+	cfg := engineConfig{&copyProfile, enabled}
+	if err := db.CreateProject(ctx, &store.Project{ID: "project", RootDirs: []string{root}, ApprovalMode: store.ApprovalFull}); err != nil {
+		return report, err
+	}
+	if err := db.CreateSession(ctx, &store.Session{ID: "session", Title: "Memo Engine validation", Provider: copyProfile.ProfileID(), Model: model, ProjectID: "project", ActiveMode: store.ModeCode, ModeLease: store.ModeLeaseSession}); err != nil {
+		return report, err
+	}
+	transport := probeTransport(func(req *http.Request) (*http.Response, error) {
+		if report.Requests >= maxRequests {
+			return nil, errors.New("engine fixture request limit")
+		}
+		report.Requests++
+		raw, err := io.ReadAll(req.Body)
+		if err != nil {
+			return nil, err
+		}
+		req.Body = io.NopCloser(bytes.NewReader(raw))
+		var wire struct {
+			Messages []map[string]json.RawMessage `json:"messages"`
+		}
+		if err := json.Unmarshal(raw, &wire); err != nil {
+			return nil, err
+		}
+		history, err := db.ListMessages(ctx, "session", 0)
+		if err != nil {
+			return nil, err
+		}
+		for _, m := range wire.Messages {
+			var role, content string
+			_ = json.Unmarshal(m["role"], &role)
+			_ = json.Unmarshal(m["content"], &content)
+			if role == "user" && strings.Contains(content, "Previously recorded assistant work note (not a new user request):") {
+				report.RecoveredNoteSent = true
+			}
+			if role == "tool" {
+				var envelope struct {
+					View string `json:"view"`
+				}
+				_ = json.Unmarshal([]byte(content), &envelope)
+				if envelope.View == "released" {
+					report.ReleasedSent++
+				}
+			}
+			if len(m["tool_calls"]) == 0 {
+				continue
+			}
+			found := false
+			for _, saved := range history {
+				if saved.ProviderState == nil {
+					continue
+				}
+				var native map[string]json.RawMessage
+				if json.Unmarshal(saved.ProviderState.Data, &native) != nil {
+					continue
+				}
+				var a, b any
+				_ = json.Unmarshal(native["tool_calls"], &a)
+				_ = json.Unmarshal(m["tool_calls"], &b)
+				if !reflect.DeepEqual(a, b) {
+					continue
+				}
+				if !bytes.Equal(native["reasoning_content"], m["reasoning_content"]) {
+					return nil, errors.New("native reasoning changed")
+				}
+				var thought string
+				_ = json.Unmarshal(native["reasoning_content"], &thought)
+				report.ReasoningSeen = report.ReasoningSeen || thought != ""
+				report.NativeChecked++
+				found = true
+				break
+			}
+			if !found {
+				return nil, errors.New("wire call has no matching canonical native source")
+			}
+		}
+		return http.DefaultTransport.RoundTrip(req)
+	})
+	client := openai.New(openai.Config{BaseURL: copyProfile.BaseURL, APIKey: config.EffectiveAPIKey(&copyProfile), HTTPClient: &http.Client{Transport: transport, Timeout: 2 * time.Minute}})
+	runner := &engineTools{BuiltinRunner: tool.NewBuiltinRunner(tool.WithHistorySearch(db))}
+	defer runner.Close()
+	eng := engine.New(db, event.NewHub(), registry.Static(client), cfg, engine.WithTools(runner))
+	defer func() { _ = eng.Cancel("session"); eng.Stop(); eng.Wait() }()
+	prompt := "Read the first 160 lines of inventory.txt to locate the password-reset handler, then read that handler. Explain which HTTP status an expired token receives. Do not guess the filename before reading inventory. Keep the answer concise."
+	if enabled && explicit {
+		prompt += " Exercise summarize_results on the already-needed handler read: put the inventory outer result_ref in result_refs, retain the handler filename in summary. No extra cleanup tool call."
+	}
+	submitted, err := eng.Submit(ctx, engine.SubmitInput{SessionID: "session", ClientMessageID: "task", Text: prompt})
+	if err != nil {
+		return report, err
+	}
+	waitCtx, cancel := context.WithTimeout(ctx, 3*time.Minute)
+	defer cancel()
+	if err := eng.WaitSession(waitCtx, "session"); err != nil {
+		return report, err
+	}
+	eng.Stop()
+	eng.Wait()
+	report.Tools = runner.calls
+	report.TaskRequests = report.Requests
+	turn, err := db.GetConversationTurn(ctx, "session", submitted.TurnID)
+	if err != nil {
+		return report, err
+	}
+	taskPassed := turn.Status == store.TurnCompleted
+	var answer strings.Builder
+	for _, m := range turn.Messages {
+		if m.Role == store.RoleAssistant {
+			answer.WriteString(m.Text)
+		}
+	}
+	taskPassed = taskPassed && strings.Contains(answer.String(), "401")
+	saved, err := db.GetToolMemoContext(ctx, "session")
+	if err != nil && !errors.Is(err, store.ErrNotFound) {
+		return report, err
+	}
+	if saved != nil {
+		for _, d := range saved.Decisions {
+			report.Applied += len(d.Applied)
+		}
+	}
+	report.Usage, err = db.SessionUsage(ctx, "session")
+	if err != nil {
+		return report, err
+	}
+	if err := db.Close(); err != nil {
+		return report, err
+	}
+	db, err = sqlitestore.Open(dbPath)
+	if err != nil {
+		return report, err
+	}
+	restored, loadErr := db.GetToolMemoContext(ctx, "session")
+	report.RestartOK = reflect.DeepEqual(saved, restored) && (loadErr == nil || (!enabled && errors.Is(loadErr, store.ErrNotFound)))
+	// Check the exact public history consumed by Desktop, after reopening SQLite.
+	publicTurn, err := db.GetConversationTurn(ctx, "session", submitted.TurnID)
+	if err != nil {
+		return report, err
+	}
+	notes := map[string]store.ToolMemoNote{}
+	anchors := map[string]string{}
+	report.PublicNotesOK = true
+	for _, m := range publicTurn.Messages {
+		for _, n := range store.ToolMemoNotes(m.Metadata) {
+			if _, duplicate := notes[n.ID]; duplicate {
+				report.PublicNotesOK = false
+			}
+			notes[n.ID], anchors[n.ID] = n, m.ID
+		}
+	}
+	expected := 0
+	if restored != nil {
+		for _, d := range restored.Decisions {
+			if d.Note == "" {
+				continue
+			}
+			expected++
+			n, ok := notes[d.ID]
+			report.PublicNotesOK = report.PublicNotesOK && ok && n.Note == d.Note && n.BatchID == d.RequestID && reflect.DeepEqual(n.CallIDs, d.BatchCalls)
+		}
+	}
+	report.PublicNotesOK = report.PublicNotesOK && len(notes) == expected
+	events, err := db.EventsAfter(ctx, "session", 0, 0)
+	if err != nil {
+		return report, err
+	}
+	replayed := map[string]bool{}
+	report.MemoReplayOK = true
+	for _, ev := range events {
+		if ev.Kind != event.TurnMemo {
+			continue
+		}
+		report.MemoReplayOK = report.MemoReplayOK && !replayed[ev.MemoID] && anchors[ev.MemoID] == ev.MessageID && ev.TurnID == submitted.TurnID && ev.Seq > 0
+		replayed[ev.MemoID] = true
+	}
+	report.MemoReplayOK = report.MemoReplayOK && len(replayed) == expected
+	if err := os.WriteFile(filepath.Join(root, "inventory.txt"), []byte("CHANGED"), 0600); err != nil {
+		return report, err
+	}
+	report.ReadbackOK = true
+	reader := tool.NewBuiltinRunner(tool.WithHistorySearch(db))
+	defer reader.Close()
+	if saved != nil {
+		for _, d := range saved.Decisions {
+			for _, ref := range d.Applied {
+				args, _ := json.Marshal(map[string]any{"result_ref": ref, "field": "content", "limit": 200})
+				read := reader.Call(ctx, tool.Call{SessionID: "session", Name: tool.HistoryGetMessage, Args: args})
+				report.ReadbackOK = report.ReadbackOK && read.Ok && strings.Contains(read.Content, "auth_reset.go")
+			}
+		}
+	}
+	report.Passed = taskPassed && report.RestartOK && report.ReadbackOK && report.PublicNotesOK && report.MemoReplayOK && (!enabled || (report.Applied > 0 && report.ReleasedSent > 0 && report.NativeChecked > 0 && report.ReasoningSeen))
+	if report.Passed && enabled && recovery {
+		// An independent follow-up after reopening SQLite and closing admission
+		// exercises fixed projections and note recovery in a new native chain.
+		cfg.enabled = false
+		followRunner := &engineTools{BuiltinRunner: tool.NewBuiltinRunner(tool.WithHistorySearch(db))}
+		defer followRunner.Close()
+		follow := engine.New(db, event.NewHub(), registry.Static(client), cfg, engine.WithTools(followRunner))
+		defer func() { _ = follow.Cancel("session"); follow.Stop(); follow.Wait() }()
+		input, err := follow.Submit(ctx, engine.SubmitInput{SessionID: "session", ClientMessageID: "recovery", Text: "Which handler filename did you inspect? Answer from our prior work note without using tools."})
+		if err != nil {
+			return report, err
+		}
+		if err := follow.WaitSession(waitCtx, "session"); err != nil {
+			return report, err
+		}
+		follow.Stop()
+		follow.Wait()
+		followTurn, err := db.GetConversationTurn(ctx, "session", input.TurnID)
+		if err != nil {
+			return report, err
+		}
+		var text strings.Builder
+		for _, m := range followTurn.Messages {
+			if m.Role == store.RoleAssistant {
+				text.WriteString(m.Text)
+			}
+		}
+		usage, err := db.SessionUsage(ctx, "session")
+		if err != nil {
+			return report, err
+		}
+		report.RecoveryUsage = &provider.UsageInfo{InputUncachedTokens: usage.LastInputUncachedTokens, InputCachedTokens: usage.LastInputCachedTokens, CacheCreationTokens: usage.LastCacheCreationTokens, OutputContentTokens: usage.LastOutputContentTokens, OutputReasoningTokens: usage.LastOutputReasoningTokens}
+		report.RecoveryRequests = report.Requests - report.TaskRequests
+		report.RecoveryPassed = followTurn.Status == store.TurnCompleted && strings.Contains(text.String(), "auth_reset.go") && followRunner.calls == 0 && report.RecoveredNoteSent
+		report.Passed = report.Passed && report.RecoveryPassed
+	}
+	if !report.Passed {
+		return report, fmt.Errorf("engine fixture did not pass: turn=%s error=%s", turn.Status, turn.Error)
+	}
+	return report, nil
+}
