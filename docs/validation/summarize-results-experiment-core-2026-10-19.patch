+		t.Fatal("restart lost state", err)
+	}
+	publicTurn, err = db.GetConversationTurn(ctx, "s", "t")
+	if err != nil {
+		t.Fatal(err)
+	}
+	publicNotes = 0
+	for _, m := range publicTurn.Messages {
+		publicNotes += len(store.ToolMemoNotes(m.Metadata))
