+		t.Fatalf("public notes=%d", publicNotes)
+	}
+	// Complete model response, then cancellation before any business result.
+	// The note commits once; release stays skipped and no request is added.
+	recoveryReq, err := eng.buildProviderRequest(ctx, "s", resolved, store.ModeCode)
+	if err != nil {
+		t.Fatal(err)
+	}
+	source, err := eng.prepareMemoRequest(ctx, "s", recoveryReq)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cancelNote := "Cancellation work note"
+	cancelArgs := json.RawMessage(memoJSON(map[string]any{"scope": "project", "path": "later.go", "summarize_results": map[string]any{"result_refs": []store.ToolMemoRef{ref}, "summary": cancelNote}}))
