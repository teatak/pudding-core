+func TestPrototypeRunnerRejectsUndeclaredWrites(t *testing.T) {
+	r := &engineTools{BuiltinRunner: tool.NewBuiltinRunner()}
+	defer r.Close()
+	dir := t.TempDir()
+	args, _ := json.Marshal(map[string]any{"scope": "project", "path": "unexpected.txt", "content": "must not write"})
+	result := r.Call(context.Background(), tool.Call{Name: tool.FileWrite, Args: args, ProjectDirs: []string{dir}})
+	if result.Ok || !strings.Contains(result.Content, "prototype_tool_unavailable") {
+		t.Fatalf("undeclared tool dispatched: %+v", result)
+	}
+	if _, err := os.Stat(filepath.Join(dir, "unexpected.txt")); !os.IsNotExist(err) {
+		t.Fatal("write reached real runner")
+	}
+	defs, err := r.Definitions(context.Background(), "session")
+	if err != nil || len(defs) != 2 {
+		t.Fatalf("unexpected tool definitions: %v %v", defs, err)
