+						args["summarize_results"] = Control{ResultRefs: []tool.ResultReference{findResult(t, messages, "a").Ref}, Summary: &note}
+					}
+					return sseCall("b", jsonText(args))
+				case 3:
+					if findResult(t, messages, "a").View != "content" {
+						t.Fatal("skipped release was applied later")
+					}
+					return sseAnswer()
+				default:
+					t.Fatal("extra request")
+					return ""
+				}
+			})
+			runner.MinInputReduction = 1_000_000
+			turn, err := runner.StartTurn("inspect")
+			if err != nil {
+				t.Fatal(err)
+			}
+			for i := 0; i < 3; i++ {
+				if _, err := runner.Step(context.Background(), turn); err != nil {
+					t.Fatal(err)
+				}
+				// A later threshold change must not retroactively apply the decision.
+				if i == 1 {
+					runner.MinInputReduction = 1
+				}
+			}
+			if *count != 3 {
+				t.Fatal("request count changed")
+			}
+			if withMemo && (len(runner.State.Decisions) != 1 || len(runner.State.Decisions[0].Applied) != 0 || runner.State.Decisions[0].Skipped[0].Reason != "below_threshold") {
