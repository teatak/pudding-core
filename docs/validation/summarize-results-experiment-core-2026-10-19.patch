new file mode 100644
--- /dev/null
+++ b/cmd/memo-prototype/compare.py
@@ -0,0 +1,63 @@
+#!/usr/bin/env python3
+"""Interleave frozen legacy/candidate binaries; retain every outcome, never retry."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--legacy", type=Path, required=True)
+    parser.add_argument("--candidate", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--provider", required=True)
+    parser.add_argument("--model", default="deepseek-flash")
+    args = parser.parse_args()
+    bins = {"legacy": args.legacy.resolve(), "candidate": args.candidate.resolve()}
+    hashes = {name: hashlib.sha256(path.read_bytes()).hexdigest() for name, path in bins.items()}
+    # Refuse to overwrite an earlier experiment, including its failures.
+    args.output_dir.mkdir(parents=True, exist_ok=False)
+    combined = {"fixtureVersion": "incident-chain-v1", "order": "rotating three arms",
+                "plannedRuns": 12, "binarySHA256": hashes, "runs": []}
+    failed = False
+    for sample in range(4):
+        arms = ["baseline", "legacy", "candidate"]
+        offset = sample % len(arms)
+        for arm in arms[offset:] + arms[:offset]:
+            binary = bins["candidate" if arm == "candidate" else "legacy"]
+            report = args.output_dir / f"{sample}-{arm}.json"
+            command = [str(binary), "-long-benchmark", "-samples", "1", "-sample-start", str(sample),
+                       "-benchmark-arm", "baseline" if arm == "baseline" else "memo",
+                       "-max-requests", "24", "-provider", args.provider, "-model", args.model,
+                       "-protocol", "openai-compatible", "-output", str(report)]
+            print(f"sample={sample} arm={arm} started", flush=True)
+            item = {"sample": sample, "arm": arm}
+            with (args.output_dir / f"{sample}-{arm}.log").open("w") as log:
+                try:
+                    result = subprocess.run(command, stdout=log, stderr=log, timeout=720, check=False)
+                    item["exitCode"] = result.returncode
+                except subprocess.TimeoutExpired:
+                    item["error"] = "experiment process timeout"
+            if report.exists():
+                item["report"] = json.loads(report.read_text())
+            else:
+                item["error"] = item.get("error", "no completed report")
+            failed = failed or item.get("exitCode") != 0 or "error" in item
+            combined["runs"].append(item)
+            (args.output_dir / "comparison.json").write_text(json.dumps(combined, indent=2) + "\n")
+            runs = item.get("report", {}).get("runs", [])
+            if runs:
+                run = runs[0]
+                cost = sum(run[p]["estimatedUSDAtPeakRates"] for p in ("main", "followup"))
+                print(f"sample={sample} arm={arm} attempts={run['memoAttempts']} applied={run['applied']} "
+                      f"quality={run['main']['checksPassed']}/{run['main']['checksTotal']} "
+                      f"followup={run['followup']['correct']} USD={cost:.6f} exit={item.get('exitCode')}", flush=True)
+            else:
+                print(f"sample={sample} arm={arm} error={item.get('error')}", flush=True)
+    return int(failed)
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
