+package api
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/teatak/pudding-core/internal/engine"
+	"github.com/teatak/pudding-core/internal/event"
+	"github.com/teatak/pudding-core/internal/provider/mock"
+	"github.com/teatak/pudding-core/internal/provider/registry"
+	"github.com/teatak/pudding-core/internal/store"
+	"github.com/teatak/pudding-core/internal/store/sqlitestore"
+	"github.com/teatak/pudding-core/internal/store/storetest"
+)
+
+func TestToolMemoPublicHistoryIsScopedAndDoesNotExposeNativeState(t *testing.T) {
+	ctx := context.Background()
+	db, err := sqlitestore.Open(filepath.Join(t.TempDir(), "core.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	for _, id := range []string{"s", "other"} {
+		if err := db.CreateSession(ctx, &store.Session{ID: id, Provider: "mock", Model: "mock"}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if _, err := db.BeginTurn(ctx, store.BeginTurnInput{SessionID: "s", TurnID: "t", UserMessageID: "u", ClientMessageID: "c", UserText: "task"}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := db.AppendTurnOutput(ctx, store.AppendTurnOutputInput{TurnID: "t",
+		Parts:         []store.ContentPart{{Type: store.ContentPartToolUse, CallID: "read", Name: "read", Args: json.RawMessage(`{}`)}},
+		ProviderState: &store.ProviderState{Provider: "mock", Model: "mock", Kind: "native", Data: json.RawMessage(`{"secret":"NATIVE_SENTINEL"}`)},
+	}); err != nil {
+		t.Fatal(err)
+	}
+	memo := store.ToolMemoContext{SessionID: "s", Epoch: "epoch", ChainID: "chain", Revision: 1,
+		Decisions: []store.ToolMemoDecision{{ID: "memo", RequestID: "batch", TurnID: "t", BatchCalls: []string{"read"}, Note: "PUBLIC_NOTE"}}}
+	if _, err := db.AppendTurnOutput(ctx, store.AppendTurnOutputInput{TurnID: "t", ToolMemo: &store.ToolMemoCommit{Context: memo}}); err != nil {
+		t.Fatal(err)
+	}
+	// A cancelled batch's note can anchor on the assistant's native call. Keep
+	// the public metadata while leaving provider data private and unchanged.
+	cfg := storetest.New(t)
+	hub := event.NewHub()
+	eng := engine.New(db, hub, registry.Static(mock.New()), cfg)
+	defer func() { eng.Stop(); eng.Wait() }()
+	handler := New(eng, db, cfg, hub).Handler(testToken, nil)
+	for _, path := range []string{"/sessions/s/turns/t", "/sessions/s/turns", "/sessions/s/messages"} {
+		req := httptest.NewRequest(http.MethodGet, path, nil)
+		req.Header.Set("Authorization", "Bearer "+testToken)
+		recorder := httptest.NewRecorder()
+		handler.ServeHTTP(recorder, req)
+		body := recorder.Body.String()
+		if recorder.Code != http.StatusOK || strings.Count(body, "PUBLIC_NOTE") != 1 || !strings.Contains(body, `"batchID":"batch"`) || strings.Contains(body, "NATIVE_SENTINEL") {
+			t.Fatalf("%s: status=%d body=%s", path, recorder.Code, body)
+		}
+	}
+	req := httptest.NewRequest(http.MethodGet, "/sessions/other/turns/t", nil)
+	req.Header.Set("Authorization", "Bearer "+testToken)
+	recorder := httptest.NewRecorder()
+	handler.ServeHTTP(recorder, req)
+	if recorder.Code != http.StatusNotFound || strings.Contains(recorder.Body.String(), "PUBLIC_NOTE") {
+		t.Fatal("foreign note exposed")
+	}
+	canonical, err := db.ListMessages(ctx, "s", 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	last := canonical[len(canonical)-1]
+	if last.ProviderState == nil || !strings.Contains(string(last.ProviderState.Data), "NATIVE_SENTINEL") || len(last.Parts) != 1 {
+		t.Fatal("note changed native state or canonical parts")
+	}
+}
diff --git a/internal/engine/tool_memo.go b/internal/engine/tool_memo.go
new file mode 100644
--- /dev/null
+++ b/internal/engine/tool_memo.go
@@ -0,0 +1,342 @@
+package engine
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strings"
+
+	"github.com/teatak/pudding-core/internal/config"
+	"github.com/teatak/pudding-core/internal/provider"
+	"github.com/teatak/pudding-core/internal/provider/openai"
+	"github.com/teatak/pudding-core/internal/store"
+	"github.com/teatak/pudding-core/internal/tool"
+	"github.com/teatak/pudding-core/internal/toolmemo"
+)
+
+// Admission is intentionally a single, explicitly enabled protocol/configuration.
+// The configured profile is never rewritten to another protocol by the Engine.
+func memoVerified(profile *store.ProviderProfile, r *resolvedModel) bool {
+	effort, _ := provider.StringOption(r.config.OpenAIOptions(), "reasoning_effort")
+	output, _ := r.config.MaxOutputTokens()
+	for key := range r.config.OpenAIOptions() {
+		if key != "reasoning_effort" {
+			return false
+		}
+	}
+	return profile != nil && r.protocol == "openai-compatible" && strings.TrimRight(profile.BaseURL, "/") == "https://api.deepseek.com" && r.model == "deepseek-flash" && effort == "high" && output == 4096
+}
+func memoBoundary(messages []*store.Message) (string, string) {
+	boundary, summary := "", ""
+	for _, m := range messages {
+		if _, ok := store.SubagentResetFromMessage(m); ok {
+			boundary = m.ID
+			summary = ""
+		} else if m.Role == store.RoleSummary {
+			summary = m.ID
+		}
+	}
+	return boundary, summary
+}
+func (e *Engine) memoContext(ctx context.Context, sessionID string, r *resolvedModel, defs []provider.ToolDef) (*store.ToolMemoContext, error) {
+	backend, ok := e.store.(store.ToolMemoStore)
+	if !ok {
+		return nil, nil
+	}
+	c, err := backend.GetToolMemoContext(ctx, sessionID)
+	if err != nil && !errors.Is(err, store.ErrNotFound) {
+		return nil, err
+	}
+	settings, err := e.config.Settings(ctx)
+	if err != nil {
+		if c == nil {
+			return nil, nil
+		} // No experimental state: retain the ordinary path.
+		return nil, err
+	}
+	enabled := settings["experimental_tool_result_memo"] == "true"
+	if c == nil && !enabled {
+		return nil, nil
+	}
+	profile, err := e.config.GetProviderProfile(ctx, r.providerName)
+	if err != nil {
+		return nil, err
+	}
+	messages, err := e.store.ListMessages(ctx, sessionID, 0)
+	if err != nil {
+		return nil, err
+	}
+	boundary, summary := memoBoundary(messages)
+	configData, err := json.Marshal(r.config)
+	if err != nil {
+		return nil, err
+	}
+	binding := toolmemo.Hash(strings.Join([]string{profile.ProfileID(), r.protocol, profile.BaseURL, r.model, toolmemo.Hash(config.EffectiveAPIKey(profile)), string(configData)}, "\x00"))
+	owners := make([]string, len(defs))
+	for i, d := range defs {
+		owners[i] = d.PluginID
+	}
+	schemaData, _ := json.Marshal(struct {
+		Definitions []provider.ToolDef
+		Owners      []string
+	}{defs, owners})
+	schema := toolmemo.Hash(toolmemo.SchemaVersion + string(schemaData))
+	previous := int64(0)
+	if c != nil {
+		previous = c.Revision
+	}
+	if c == nil || c.Boundary != boundary {
+		fresh := true
+		for _, m := range store.SubagentContextMessages(messages) {
+			if m.Role == store.RoleAssistant || m.Role == store.RoleTool || m.Role == store.RoleSummary {
+				fresh = false
+			}
+		}
+		c = &store.ToolMemoContext{SessionID: sessionID, Epoch: store.NewID("epoch"), Boundary: boundary, Summary: summary, ChainID: store.NewID("chain"), Binding: binding, Schema: schema, Disabled: !enabled || !fresh || !memoVerified(profile, r), Revision: previous + 1}
+	} else if c.Binding != binding || c.Schema != schema || c.Summary != summary || (!enabled && !c.Disabled) {
+		c = toolmemo.Clone(c)
+		// Config/schema changes permanently close admission for this epoch. A
+		// compact boundary only starts a fresh native chain, not a fresh epoch.
+		if c.Binding != binding || c.Schema != schema || !enabled {
+			c.Disabled = true
+		}
+		c.Binding, c.Schema, c.Summary = binding, schema, summary
+		c.ChainID = store.NewID("chain")
+		c.Revision++
+	} else {
+		return c, nil
+	}
+	if err := backend.SaveToolMemoContext(ctx, store.ToolMemoCommit{ExpectedRevision: previous, Context: *c}); err != nil {
+		return nil, err
+	}
+	return c, nil
+}
+
+func (e *Engine) loadMemo(ctx context.Context, sessionID string) (*store.ToolMemoContext, error) {
+	backend, ok := e.store.(store.ToolMemoStore)
+	if !ok {
+		return nil, nil
+	}
+	c, err := backend.GetToolMemoContext(ctx, sessionID)
+	if errors.Is(err, store.ErrNotFound) {
+		return nil, nil
+	}
+	if err != nil || c == nil {
+		return nil, err
+	}
+	messages, err := e.store.ListMessages(ctx, sessionID, 0)
+	if err != nil {
+		return nil, err
+	}
+	boundary, _ := memoBoundary(messages)
+	// Read-only paths may run after reset but before the next turn initializes
+	// its epoch. Never reintroduce the previous epoch's notes in that interval.
+	if c.Boundary != boundary {
+		return nil, nil
+	}
+	return c, nil
+}
+
+func (e *Engine) prepareMemoRequest(ctx context.Context, sessionID string, req provider.Request) (*toolmemo.Prepared, error) {
+	c, err := e.loadMemo(ctx, sessionID)
+	if err != nil || c == nil {
+		return nil, err
+	}
+	if c.Disabled && len(c.Results) == 0 && len(c.Decisions) == 0 {
+		return nil, nil
+	}
+	prepared, err := toolmemo.Freeze(req, c)
+	if err != nil {
+		return nil, err
+	}
+	messages, err := e.store.ListMessages(ctx, sessionID, 0)
+	if err != nil {
+		return nil, err
+	}
+	prepared.SeenCalls = map[string]bool{}
+	for _, m := range store.SubagentContextMessages(messages) {
+		for _, p := range m.Parts {
+			if p.Type == store.ContentPartToolUse {
+				prepared.SeenCalls[p.CallID] = true
+			}
+		}
+	}
+	return prepared, nil
+}
+
+// This runs after the actual business batch closes and before the turn becomes
+// terminal. Results were committed by the normal execution path; note and all
+// final decisions become visible together in this CAS transaction.
+func (e *Engine) closeMemoBatch(sessionID, turnID string, source *toolmemo.Prepared, calls []tool.Call, parts *turnPartAccumulator, req provider.Request, continuations []provider.Continuation, interrupted bool) error {
+	if source == nil {
+		return nil
+	}
+	ctx := context.Background()
+	c, err := e.loadMemo(ctx, sessionID)
+	if err != nil {
+		return err
+	}
+	if c == nil {
+		return store.ErrHistoryChanged
+	}
+	if c.Epoch != source.Epoch || c.ChainID != source.ChainID || c.Revision != source.Revision {
+		return store.ErrHistoryChanged
+	}
+	next := toolmemo.Clone(c)
+	var candidate *toolmemo.Control
+	var carrier tool.Call
+	batchCalls := make([]string, 0, len(calls))
+	callMap := map[string]tool.Call{}
+	for _, call := range calls {
+		batchCalls = append(batchCalls, call.CallID)
+		callMap[call.CallID] = call
+		_, m := toolmemo.Extract(call.Args, source.Declared[call.Name])
+		if candidate == nil && m != nil {
+			candidate = m
+			carrier = call
+		}
+	}
+	// Only result refs from this exact declaration snapshot can enter the epoch.
+	// Mixed/media results and whole-message history reads are excluded.
+	attachmentBatch := false
+	for _, p := range parts.Parts() {
+		if p.Type == store.ContentPartAttachment {
+			attachmentBatch = true
+		}
+	}
+	for _, p := range parts.Parts() {
+		call, found := callMap[p.CallID]
+		if !found || p.Type != store.ContentPartToolResult || !source.Declared[call.Name] || attachmentBatch {
+			continue
+		}
+		if call.Name == tool.HistoryGetMessage {
+			var a struct {
+				Ref       tool.ResultReference `json:"result_ref"`
+				MessageID string               `json:"message_id"`
+			}
+			if json.Unmarshal(call.Args, &a) != nil || a.MessageID != "" || a.Ref.CallID == "" || a.Ref.TurnID == "" {
+				continue
+			}
+		}
+		ref := store.ToolMemoRef{TurnID: turnID, CallID: p.CallID}
+		if !toolmemo.Registered(next, ref, p.Name) {
+			next.Results = append(next.Results, store.ToolMemoResult{Ref: ref, Name: p.Name})
+		}
+	}
+	if candidate != nil {
+		d := store.ToolMemoDecision{ID: source.ID + ":" + carrier.CallID, RequestID: source.ID, TurnID: turnID, CarrierID: carrier.CallID, CarrierArgsHash: toolmemo.Hash(string(carrier.Args)), BatchCalls: batchCalls}
+		if candidate.Summary != nil {
+			d.Note = *candidate.Summary
+		}
+		seen := map[store.ToolMemoRef]bool{}
+		for _, r := range candidate.ResultRefs {
+			ref := store.ToolMemoRef{TurnID: r.TurnID, CallID: r.CallID}
+			if seen[ref] {
+				continue
+			}
+			seen[ref] = true
+			reason := ""
+			entry, visible := source.Visible[ref]
+			switch {
+			case interrupted:
+				reason = "interrupted_batch"
+			case next.Disabled:
+				reason = "admission_closed"
+			case toolmemo.Applied(next, ref):
+				reason = "already_released"
+			case !visible || entry.View != "content":
+				reason = "not_visible"
+			case d.Note == "":
+				reason = "missing_note"
+			default:
+				// The builtin reader enforces same-session membership and uniqueness;
+				// reading a short page verifies the canonical snapshot still exists.
+				args, _ := json.Marshal(map[string]any{"result_ref": ref, "limit": 1})
+				builtin := tool.NewBuiltinRunner(tool.WithHistorySearch(e.store))
+				result := builtin.Call(ctx, tool.Call{SessionID: sessionID, Name: tool.HistoryGetMessage, Args: args})
+				_ = builtin.Close()
+				if !result.Ok {
+					reason = "not_readable"
+				}
+			}
+			if reason != "" {
+				d.Skipped = append(d.Skipped, store.ToolMemoSkipped{Ref: ref, Reason: reason})
+			} else {
+				d.Applied = append(d.Applied, ref)
+			}
+		}
+		if len(d.Applied) > 0 {
+			trial := toolmemo.Clone(next)
+			trial.Decisions = append(trial.Decisions, d)
+			req.Messages = requestMessagesWithTurnParts(req.Messages, parts.Parts(), continuations, sessionID, turnID, e.attachmentHome, req.Config, tool.HasDefinition(req.Tools, tool.HistoryGetMessage))
+			baseline := toolmemo.Clone(next)
+			baseline.Results = nil
+			for _, result := range next.Results {
+				if toolmemo.Applied(next, result.Ref) {
+					baseline.Results = append(baseline.Results, result)
+				}
+			}
+			before, err := toolmemo.Freeze(toolmemo.WithoutControl(req), baseline)
+			if err != nil {
+				return err
+			}
+			after, err := toolmemo.Freeze(req, trial)
+			if err != nil {
+				return err
+			}
+			a, err := before.HTTP.Input().Estimate()
+			if err != nil {
+				return err
+			}
+			b, err := after.HTTP.Input().Estimate()
+			if err != nil {
+				return err
+			}
+			memoData, _ := json.Marshal(candidate)
+			if a.Total()-b.Total()-provider.EstimateTextTokens(string(memoData)) < 64 {
+				for _, ref := range d.Applied {
+					d.Skipped = append(d.Skipped, store.ToolMemoSkipped{Ref: ref, Reason: "below_threshold"})
+				}
+				d.Applied = nil
+			}
+		}
+		next.Decisions = append(next.Decisions, d)
+	}
+	next.Revision++
+	_, err = e.store.AppendTurnOutput(ctx, store.AppendTurnOutputInput{TurnID: turnID, ToolMemo: &store.ToolMemoCommit{ExpectedRevision: c.Revision, Context: *next}})
+	return err
+}
+
+// Prepared requests have no compatibility retry. Callers count precisely one
+// HTTP attempt and cannot accidentally inspect a different projection.
+func streamMemo(ctx context.Context, client provider.Client, req provider.Request, p *toolmemo.Prepared) (<-chan provider.Chunk, error) {
+	if p == nil {
+		return client.Stream(ctx, req)
+	}
+	if prepared, ok := client.(interface {
+		StreamPrepared(context.Context, *openai.PreparedChatRequest) (<-chan provider.Chunk, error)
+	}); ok {
+		return prepared.StreamPrepared(ctx, p.HTTP)
+	}
+	if len(p.Declared) > 0 {
+		return nil, fmt.Errorf("memo: client cannot send frozen Chat request")
+	}
+	return nil, fmt.Errorf("memo: fixed-history handoff for this protocol is not verified; start a new conversation or reset")
+}
+
+// A reused model call ID would alias an applied (turn,call) reference to a new,
+// unseen result. Reject before any business side effect or result persistence.
+func validateMemoCalls(source *toolmemo.Prepared, calls []tool.Call) error {
+	seen := map[string]bool{}
+	for id := range source.SeenCalls {
+		seen[id] = true
+	}
+	for _, c := range calls {
+		if c.CallID == "" || seen[c.CallID] || !json.Valid(c.Args) {
+			return fmt.Errorf("memo: missing, repeated, or incomplete tool call")
+		}
+		seen[c.CallID] = true
+	}
+	return nil
+}
