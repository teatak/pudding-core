+		for _, r := range out.Requests {
+			if enabled != (r.MemoTools == 2) {
+				t.Fatalf("memo eligibility not observed: %+v", r)
+			}
+			if enabled != r.InstructionsSeen {
+				t.Fatal("system instruction presence not observed")
