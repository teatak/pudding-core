+	"github.com/teatak/pudding-core/internal/tool"
+	"github.com/teatak/pudding-core/internal/toolmemo"
+)
+
+const schemaVersion = toolmemo.SchemaVersion
+const memoInstructions = toolmemo.Instructions
+
+type Control = toolmemo.Control
+
+func allowedTool(name string) bool { return name == tool.FileSlice || name == tool.HistoryGetMessage }
+func Decorate(defs []provider.ToolDef) ([]provider.ToolDef, map[string]bool) {
+	return toolmemo.Decorate(defs)
+}
+func Extract(args json.RawMessage, declared bool) (json.RawMessage, *Control) {
+	return toolmemo.Extract(args, declared)
