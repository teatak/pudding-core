+func TestSchemaAndExtractionPreserveBusinessContract(t *testing.T) {
+	defs := []provider.ToolDef{
+		{Name: tool.FileSlice, InputSchema: json.RawMessage(`{"type":"object","properties":{"path":{"type":"string"}},"required":["path"],"additionalProperties":false}`)},
+		{Name: tool.HistoryGetMessage, InputSchema: json.RawMessage(`{"type":"object","properties":{"summarize_results":{"type":"string"}}}`)},
+		{Name: "third_party", PluginID: "third-party", InputSchema: json.RawMessage(`{"type":"object","properties":{}}`)},
+	}
+	before := jsonText(defs)
+	decorated, declared := Decorate(defs)
+	if jsonText(defs) != before || !declared[tool.FileSlice] || declared[tool.HistoryGetMessage] || string(decorated[2].InputSchema) != string(defs[2].InputSchema) {
+		t.Fatal("schema mutated or business memo claimed")
+	}
+	for _, memo := range []string{`null`, `{"result_refs":[],"summary":null}`, `{"result_refs":[],"unknown":1}`, `{"result_refs":[],"summary":"` + strings.Repeat("中", 801) + `"}`, `{"result_refs":null,"summary":null}`} {
+		args := json.RawMessage(`{"path":"a.txt","summarize_results":` + memo + `}`)
+		copy, parsed := Extract(args, true)
+		if string(copy) != `{"path":"a.txt"}` || !strings.Contains(string(args), `"summarize_results"`) {
+			t.Fatal("execution/raw parameters not separated")
+		}
+		if parsed != nil {
+			t.Fatalf("bad memo validation: %s", memo)
+		}
+		unchanged, _ := Extract(args, false)
+		if string(unchanged) != string(args) {
+			t.Fatal("undeclared business memo removed")
+		}
+	}
+}
